+    /// Whether a pid names a live process. Linux gives every process a directory
+    /// under `/proc`; where that is not mounted the answer is unknown, and an
+    /// unknown holder counts as running, because taking the lock from a live
+    /// resume is worse than answering `busy`.
+    fn running(pid: u32) -> bool {
+        if pid == std::process::id() {
+            return true;
+        }
+        match std::fs::metadata("/proc") {
+            Ok(meta) if meta.is_dir() => Path::new(&format!("/proc/{pid}")).exists(),
+            _ => true,
+        }
+    }
