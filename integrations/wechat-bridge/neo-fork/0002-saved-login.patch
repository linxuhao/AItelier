+/// The account a stored login opened: the client this session goes on to use,
+/// and the name WeChat knew it by.
+struct AcceptedAccount {
+    client: NativeClient,
+    username: String,
+}
+
+/// The status token one resume attempt answers. One of the closed set the bridge
+/// branches on; `resumed` is the only answer that also names an account.
+fn resume_status<T>(answered: &stored_login::Answer<T>) -> &'static str {
+    match answered {
+        stored_login::Answer::None => "none",
+        stored_login::Answer::Unreadable => "unreadable",
+        stored_login::Answer::Throttled => "throttled",
+        stored_login::Answer::Busy => "busy",
+        stored_login::Answer::Resumed { .. } => "resumed",
+    }
+}
+
+/// Try the stored login instead of the QR path.
+fn resume_login(session: &mut Session) -> Result<Value> {
+    ensure!(session.account.is_none(), "A session is already active");
+    let store = match stored_login::Store::from_env() {
+        Ok(store) => store,
+        // Saved logins are off. The answer is still one of the closed set, and it
+        // says why, so a start can tell a build without a store from a login that
+        // is simply not there.
+        Err(off) => return Ok(json!({ "status": "none", "off": off.as_str() })),
+    };
+    let answer =
+        stored_login::resume(&store, now_seconds()?.into(), |state| open_stored_login(state))?;
+    let status = resume_status(&answer);
+    let stored_login::Answer::Resumed { accepted, .. } = answer else {
+        return Ok(json!({ "status": status }));
+    };
+    session.account = Some(accepted.client);
+    Ok(json!({ "status": status, "username": accepted.username }))
+}
+
+/// Turn the bytes a stored login holds into a live account, and say how that
+/// went. Bytes this build cannot use are `Unreadable`, which keeps the file: a
+/// document from another version is evidence, not garbage. Credentials WeChat
+/// refuses are `Rejected`, which drops it, because the login in it is not good
+/// any more.
+fn open_stored_login(bytes: &[u8]) -> Result<stored_login::Opened<AcceptedAccount>> {
+    let Ok(state) = serde_json::from_slice::<AccountState>(bytes) else {
+        return Ok(stored_login::Opened::Unreadable);
+    };
+    // Constructing a client touches no network and no store, so a document that
+    // fails here is unreadable rather than a failed resume.
+    let Ok(client) = NativeClient::from_account(state, options()) else {
+        return Ok(stored_login::Opened::Unreadable);
+    };
+    // The one request that decides it: WeChat either renews these credentials or
+    // refuses them, and a refusal is the only answer that may delete the file.
+    match client.renew_session_blocking(DEVICE_NAME) {
+        Ok(()) => {}
+        Err(error) if is_session_rejected(&error) => return Ok(stored_login::Opened::Rejected),
+        Err(error) => return Err(error),
+    }
+    // A renewal rotates the credentials, so the account state this attempt
+    // accepted is what the next process has to find on disk.
+    let refreshed = client.export_account_state()?;
+    let username = refreshed.own_username.clone();
+    stored_login::record(&refreshed);
+    Ok(stored_login::Opened::Accepted(AcceptedAccount {
+        client,
+        username,
+    }))
+}
