+
+    /// The one envelope schema this build writes, and the only one it opens.
+    const SCHEMA: &str = "puppet-neo/stored-login/1";
+    /// The AAD binds a ciphertext to this schema, so a document whose schema
+    /// line was edited (or a ciphertext moved into another purpose's slot)
+    /// fails to open instead of decrypting.
+    const AAD: &[u8] = b"puppet-neo/stored-login/1";
+    const STATE_FILE: &str = "account.v1";
+    const RESUMES_FILE: &str = "resumes";
+    pub const KEY_LEN: usize = 32;
+    /// At most six resume attempts in an hour and twenty in a day. The counters
+    /// live in the store, not in memory, so a restart does not reset them.
+    pub const RESUMES_PER_HOUR: usize = 6;
+    pub const RESUMES_PER_DAY: usize = 20;
+    const HOUR: u64 = 3_600;
+    const DAY: u64 = 86_400;
+    /// The writer lock one resume at a time holds. It carries the holder's pid so
+    /// a file a killed process left behind can be told from a live holder.
+    const LOCK_FILE: &str = "resume.lock";
+
+    /// This process's stored-login writes and failed writes. They are not
+    /// persisted: a fresh process starts at zero, so the row describes the
+    /// bridge that is running now, not what ever happened.
+    static WRITES: AtomicU64 = AtomicU64::new(0);
+    static WRITE_FAILURES: AtomicU64 = AtomicU64::new(0);
+
+    /// Why persistence is off — the closed set a status row may show.
+    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
+    pub enum Off {
+        NotConfigured,
+        Key,
+        Dir,
+    }
+
+    impl Off {
+        pub fn as_str(self) -> &'static str {
+            match self {
+                Off::NotConfigured => "not_configured",
+                Off::Key => "key",
+                Off::Dir => "dir",
+            }
+        }
+    }
+
+    /// Why a stored login was not resumed. `Absent` is the design's `none`.
+    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
+    pub enum Miss {
+        Absent,
+        Unreadable,
+    }
+
+    impl Miss {
+        pub fn as_str(self) -> &'static str {
+            match self {
+                Miss::Absent => "none",
+                Miss::Unreadable => "unreadable",
+            }
+        }
+    }
+
+    /// Whether one resume attempt may contact WeChat now.
+    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
+    pub enum Allowance {
+        Allowed,
+        Throttled,
+    }
+
+    impl Allowance {
+        pub fn as_str(self) -> &'static str {
+            match self {
+                Allowance::Allowed => "allowed",
+                Allowance::Throttled => "throttled",
+            }
+        }
+    }
+
+    #[derive(Debug, Clone)]
+    pub struct Store {
+        dir: PathBuf,
+        key: [u8; KEY_LEN],
+    }
+
+    impl Store {
+        /// Resolve the operator's two paths. Any of these answers off, and a
+        /// store that is off is never read or written: neither variable set, a
+        /// key that is not 32 bytes in an owner-only regular file, a state
+        /// directory that is missing, is not a directory, or does not accept a
+        /// file.
+        pub fn from_parts(
+            state_dir: Option<OsString>,
+            key_file: Option<OsString>,
+        ) -> std::result::Result<Store, Off> {
+            let (Some(dir), Some(key_file)) = (state_dir, key_file) else {
+                return Err(Off::NotConfigured);
+            };
+            let dir = PathBuf::from(dir);
+            if !dir.is_dir() {
+                return Err(Off::Dir);
+            }
+            let key = read_key(&PathBuf::from(key_file))?;
+            probe_writable(&dir).map_err(|_| Off::Dir)?;
+            Ok(Store { dir, key })
+        }
+
+        pub fn from_env() -> std::result::Result<Store, Off> {
+            Store::from_parts(
+                std::env::var_os(STATE_DIR_ENV),
+                std::env::var_os(STATE_KEY_ENV),
+            )
+        }
+
+        pub fn dir(&self) -> &Path {
+            &self.dir
+        }
+
+        pub fn state_path(&self) -> PathBuf {
+            self.dir.join(STATE_FILE)
+        }
+
+        pub fn resumes_path(&self) -> PathBuf {
+            self.dir.join(RESUMES_FILE)
+        }
+
+        pub fn lock_path(&self) -> PathBuf {
+            self.dir.join(LOCK_FILE)
+        }
+
+        /// Is there a stored login? lstat only — the answer a status row needs
+        /// and must not pay a decrypt for. A file that exists but will not open
+        /// still answers true here; `read` is what tells the two apart.
+        pub fn present(&self) -> bool {
+            self.state_path().symlink_metadata().is_ok()
+        }
+
+        /// Seal `plaintext` and put it in place atomically.
+        pub fn write(&self, plaintext: &[u8]) -> Result<()> {
+            let envelope = seal(&self.key, plaintext)?;
+            atomic_write(&self.state_path(), &envelope)
+        }
+
+        pub fn read(&self) -> std::result::Result<Vec<u8>, Miss> {
+            let envelope = match std::fs::read(self.state_path()) {
+                Ok(bytes) => bytes,
+                Err(err) if err.kind() == ErrorKind::NotFound => return Err(Miss::Absent),
+                Err(_) => return Err(Miss::Unreadable),
+            };
+            open(&self.key, &envelope).map_err(|_| Miss::Unreadable)
+        }
+
+        /// Remove the stored login. Idempotent: a file that is already gone is
+        /// the state the caller asked for.
+        pub fn delete(&self) -> Result<()> {
+            match std::fs::remove_file(self.state_path()) {
+                Ok(()) => Ok(()),
+                Err(err) if err.kind() == ErrorKind::NotFound => Ok(()),
+                Err(err) => Err(err.into()),
+            }
+        }
+
+        /// Count one resume attempt and say whether it may go. A counter file
+        /// that cannot be read, cannot be parsed or cannot be written fails
+        /// closed: the attempt is refused rather than left uncounted.
+        pub fn allow_resume(&self, now: u64) -> Allowance {
+            let mut seen = match read_counters(&self.resumes_path()) {
+                Ok(seen) => seen,
+                Err(_) => return Allowance::Throttled,
+            };
+            seen.retain(|at| now.saturating_sub(*at) < DAY);
+            let hour = seen
+                .iter()
+                .filter(|at| now.saturating_sub(**at) < HOUR)
+                .count();
+            if hour >= RESUMES_PER_HOUR || seen.len() >= RESUMES_PER_DAY {
+                return Allowance::Throttled;
+            }
+            seen.push(now);
+            let mut body = String::new();
+            for at in &seen {
+                body.push_str(&format!("{at}\n"));
+            }
+            if atomic_write(&self.resumes_path(), body.as_bytes()).is_err() {
+                return Allowance::Throttled;
+            }
+            Allowance::Allowed
+        }
+    }
+
+    impl Store {
+        /// Seal `plaintext`, count the attempt, and put it in place atomically.
+        /// A write that fails is counted too: a store that cannot be written is
+        /// the thing the counters exist to show.
+        pub fn save(&self, plaintext: &[u8]) -> Result<()> {
+            let written = self.write(plaintext);
+            match &written {
+                Ok(()) => WRITES.fetch_add(1, Ordering::Relaxed),
+                Err(_) => WRITE_FAILURES.fetch_add(1, Ordering::Relaxed),
+            };
+            written
+        }
+    }
+
+    /// What turning a stored login into a live account answered.
+    pub enum Opened<T> {
+        /// WeChat accepted the credentials the stored bytes carry.
+        Accepted(T),
+        /// The bytes are not a login this build can use; the file is kept.
+        Unreadable,
+        /// WeChat refused these credentials; the file is deleted.
+        Rejected,
+    }
+
+    /// One resume attempt's answer: the closed set a caller branches on.
+    #[derive(Debug, PartialEq)]
+    pub enum Answer<T> {
+        /// No stored login, or the store is off.
+        None,
+        /// A stored login is there and did not open. The file is kept.
+        Unreadable,
+        /// The counters refused this attempt. No envelope was read.
+        Throttled,
+        /// Another resume holds the writer lock. Nothing was read or counted.
+        Busy,
+        /// WeChat accepted the stored login. `state` is the plaintext the store
+        /// returned, which is the account state `open` accepted.
+        Resumed { state: Vec<u8>, accepted: T },
+    }
+
+    /// The resume writer lock, held for one attempt and dropped on every exit
+    /// path, a panic included.
+    struct Lock {
+        path: PathBuf,
+    }
+
+    impl Lock {
+        /// Take the lock, or answer `None` when another resume holds it. The lock
+        /// file is created with `create_new`, so two attempts cannot both win it;
+        /// a holder whose pid is gone is what a killed process leaves behind and
+        /// may be removed. The create is retried once after removing a stale file,
+        /// and a second refusal means somebody else won that race - the same
+        /// `busy`.
+        fn take(store: &Store) -> Result<Option<Lock>> {
+            let path = store.lock_path();
+            for attempt in 0..2 {
+                match OpenOptions::new()
+                    .write(true)
+                    .create_new(true)
+                    .mode(0o600)
+                    .open(&path)
+                {
+                    Ok(mut file) => {
+                        let written = (|| -> Result<()> {
+                            file.write_all(format!("{}\n", std::process::id()).as_bytes())?;
+                            file.sync_all()?;
+                            Ok(())
+                        })();
+                        if let Err(err) = written {
+                            let _ = std::fs::remove_file(&path);
+                            return Err(err);
+                        }
+                        return Ok(Some(Lock { path }));
+                    }
+                    Err(err) if err.kind() == ErrorKind::AlreadyExists => {
+                        if attempt == 1 || holder_running(&path) {
+                            return Ok(None);
+                        }
+                        let _ = std::fs::remove_file(&path);
+                    }
+                    Err(err) => return Err(err.into()),
+                }
+            }
+            Ok(None)
+        }
+    }
+
+    impl Drop for Lock {
+        fn drop(&mut self) {
+            let _ = std::fs::remove_file(&self.path);
+        }
+    }
+
+    /// Is the process that wrote this lock still running? A file with no pid in it
+    /// is the same as a pid that answers nothing: no holder lives there.
+    fn holder_running(path: &Path) -> bool {
+        let Ok(body) = std::fs::read_to_string(path) else {
+            return false;
+        };
+        let Ok(pid) = body.trim().parse::<u32>() else {
+            return false;
+        };
+        running(pid)
+    }
