+        #[test]
+        fn a_steal_that_cannot_take_the_reap_lock_leaves_the_stale_lock_alone() {
+            let _counting = counting();
+            let scratch = Scratch::new("reap-held");
+            let store = scratch.store();
+            // A pid no process has: what a crash leaves behind.
+            let gone = u32::MAX - 1;
+            assert_eq!(
+                start_time(gone),
+                None,
+                "the test pid names a running process"
+            );
+            let stale = format!("{gone} 1234\n");
+            std::fs::write(store.lock_path(), &stale).expect("a stale lock file");
+            // Another attempt is inside the steal. It opened the same file through
+            // its own descriptor, so this process conflicts with itself exactly as
+            // a second process would.
+            let held = reap(&store)
+                .expect("the steal can be serialised")
+                .expect("nobody else is stealing");
+
+            assert!(
+                Lock::take(&store)
+                    .expect("a busy answer is not an error")
+                    .is_none(),
+                "a lock was taken while another attempt held the steal"
+            );
+            assert_eq!(
+                std::fs::read_to_string(store.lock_path()).expect("the lock file"),
+                stale,
+                "an attempt that could not hold the steal removed the stale lock"
+            );
+
+            // Once the steal is free, the same stale lock is taken, and it names us.
+            drop(held);
+            let lead = Lock::take(&store)
+                .expect("the writer lock opens")
+                .expect("a stale lock is not a live holder");
+            assert_eq!(
+                Holder::parse(&std::fs::read(store.lock_path()).expect("the lock file")),
+                Some(Holder::current()),
+                "the stolen lock does not name this process"
+            );
+            drop(lead);
+        }
