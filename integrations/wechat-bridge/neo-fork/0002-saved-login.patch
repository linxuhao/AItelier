+    fn probe_writable(dir: &Path) -> std::io::Result<()> {
+        let probe = dir.join(format!(".probe.{}.{}", std::process::id(), nanos()));
+        let file = OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .open(&probe)?;
+        drop(file);
+        std::fs::remove_file(&probe)
+    }
+
+    fn read_counters(path: &Path) -> Result<Vec<u64>> {
+        let body = match std::fs::read_to_string(path) {
+            Ok(body) => body,
+            Err(err) if err.kind() == ErrorKind::NotFound => return Ok(Vec::new()),
+            Err(err) => return Err(err.into()),
+        };
+        let mut seen = Vec::new();
+        for line in body.lines() {
+            let line = line.trim();
+            if line.is_empty() {
+                continue;
+            }
+            seen.push(
+                line.parse::<u64>()
+                    .map_err(|_| anyhow!("a resume counter is not a unix second"))?,
+            );
+        }
+        Ok(seen)
+    }
+
+    fn atomic_write(path: &Path, bytes: &[u8]) -> Result<()> {
+        let dir = path
+            .parent()
+            .ok_or_else(|| anyhow!("the stored login has no directory"))?;
+        let name = path
+            .file_name()
+            .map(|name| name.to_string_lossy().into_owned())
+            .unwrap_or_else(|| "login".to_string());
+        let tmp = dir.join(format!(".{name}.tmp.{}.{}", std::process::id(), nanos()));
+        let write = (|| -> Result<()> {
+            let mut file = OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .mode(0o600)
+                .open(&tmp)?;
+            file.write_all(bytes)?;
+            file.sync_all()?;
+            Ok(())
+        })();
+        if let Err(err) = write {
+            let _ = std::fs::remove_file(&tmp);
+            return Err(err);
+        }
+        if let Err(err) = std::fs::rename(&tmp, path) {
+            let _ = std::fs::remove_file(&tmp);
+            return Err(err.into());
+        }
+        // The rename is durable only once the directory itself is flushed.
+        if let Ok(dir) = File::open(dir) {
+            let _ = dir.sync_all();
+        }
+        Ok(())
+    }
+
+    fn seal(key: &[u8; KEY_LEN], plaintext: &[u8]) -> Result<Vec<u8>> {
+        use openssl::symm::{Cipher, Crypter, Mode};
+        let mut nonce = [0u8; 12];
+        openssl::rand::rand_bytes(&mut nonce)?;
+        let mut crypter = Crypter::new(Cipher::aes_256_gcm(), Mode::Encrypt, key, Some(&nonce))?;
+        crypter.aad_update(AAD)?;
+        let mut body = vec![0u8; plaintext.len() + 16];
+        let mut written = crypter.update(plaintext, &mut body)?;
+        written += crypter.finalize(&mut body[written..])?;
+        body.truncate(written);
+        let mut tag = [0u8; 16];
+        crypter.get_tag(&mut tag)?;
+        let envelope = json!({
+            "schema": SCHEMA,
+            "nonce": STANDARD.encode(nonce),
+            "tag": STANDARD.encode(tag),
+            "ciphertext": STANDARD.encode(&body),
+        });
+        Ok(serde_json::to_vec(&envelope)?)
+    }
+
+    fn open(key: &[u8; KEY_LEN], envelope: &[u8]) -> Result<Vec<u8>> {
+        use openssl::symm::{Cipher, Crypter, Mode};
+        let doc: Value = serde_json::from_slice(envelope)?;
+        if doc.get("schema").and_then(Value::as_str) != Some(SCHEMA) {
+            return Err(anyhow!("the stored login carries another schema"));
+        }
+        let field = |name: &str| -> Result<Vec<u8>> {
+            let text = doc
+                .get(name)
+                .and_then(Value::as_str)
+                .ok_or_else(|| anyhow!("the stored login has no {name}"))?;
+            STANDARD
+                .decode(text)
+                .map_err(|_| anyhow!("the stored login's {name} is not base64"))
+        };
+        let nonce = field("nonce")?;
+        let tag = field("tag")?;
+        let body = field("ciphertext")?;
+        if nonce.len() != 12 || tag.len() != 16 {
+            return Err(anyhow!("the stored login's envelope is the wrong size"));
+        }
+        let mut crypter = Crypter::new(Cipher::aes_256_gcm(), Mode::Decrypt, key, Some(&nonce))?;
+        crypter.aad_update(AAD)?;
+        let mut plain = vec![0u8; body.len() + 16];
+        let mut written = crypter.update(&body, &mut plain)?;
+        crypter.set_tag(&tag)?;
+        written += crypter.finalize(&mut plain[written..])?;
+        plain.truncate(written);
+        Ok(plain)
+    }
+
+    fn nanos() -> u128 {
+        SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map(|elapsed| elapsed.as_nanos())
+            .unwrap_or(0)
+    }
