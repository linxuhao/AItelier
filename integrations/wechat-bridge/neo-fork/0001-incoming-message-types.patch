+test('a non-text message arrives with its own type and is never reported as text', async () => {
+  const { puppet, events } = scriptedPuppet([], () => ({ messages: [picture, notice] }))
+  const arrivals: payloads.EventMessage[] = []
+  const delivered = waitFor<void>(done => {
+    puppet.on('message', payload => {
+      arrivals.push(payload)
+      if (arrivals.length === 2) done()
+    })
+  }, 'both messages')
+  await puppet.start()
+  try {
+    await delivered
+    assert.deepEqual(arrivals.map(({ messageId }) => messageId), [picture.id, notice.id])
+
+    const image = await puppet.messageRawPayload(picture.id) as payloads.Message & IncomingMessage
+    assert.equal(image.type, types.Message.Image)
+    assert.equal(image.messageType, 3)
+    assert.equal(image.content, picture.content)
+    assert.equal(image.inlineData, picture.inlineData)
+    assert.equal(image.text, undefined)
+
+    // A system notice is carried with its own type; reading as text would turn
+    // WeChat's own announcement into a member speaking.
+    const system = await puppet.messageRawPayload(notice.id) as payloads.Message & IncomingMessage
+    assert.equal(system.type, types.Message.Unknown)
+    assert.notEqual(system.type, types.Message.Text)
+    assert.equal(system.messageType, 10000)
+    assert.equal(system.roomId, room)
+    assert.equal(system.text, undefined)
+    assert.deepEqual(events.errors, [])
+  } finally {
+    await puppet.stop()
+  }
+})
