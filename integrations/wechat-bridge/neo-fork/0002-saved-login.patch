+        fn saved_login_status_answers_present_and_counts_the_writes_it_saw() {
+            let _counting = counting();
+            let scratch = Scratch::new("status");
+            let store = scratch.store();
+
+            let before = status_of(scratch.configured());
+            assert_eq!(before["present"], json!(false));
+            assert!(
+                before.get("off").is_none(),
+                "a configured store carries an off reason"
+            );
+            let writes = before["writes"].as_u64().expect("a write count");
+            let failures = before["write_failures"].as_u64().expect("a failure count");
+
+            // A write that worked is counted, and the file it wrote is present
+            // without being opened.
+            store.save(b"an accepted login").expect("store the login");
+            let after = status_of(scratch.configured());
+            assert_eq!(
+                after["present"],
+                json!(true),
+                "a stored login is not reported present"
+            );
+            assert_eq!(after["writes"], json!(writes + 1), "the write was not counted");
+            assert_eq!(after["write_failures"], json!(failures));
+
+            // With neither path configured - what `from_env` reads when neither
+            // variable is set - the row says there is nothing and why.
+            let off = status_of(Store::from_parts(None, None));
+            assert_eq!(off["present"], json!(false));
+            assert_eq!(off["off"], json!("not_configured"));
+            assert_eq!(
+                off.as_object()
+                    .expect("a status row is an object")
+                    .keys()
+                    .map(String::as_str)
+                    .collect::<std::collections::BTreeSet<_>>(),
+                ["off", "present", "write_failures", "writes"]
+                    .into_iter()
+                    .collect::<std::collections::BTreeSet<_>>(),
+                "a status row carries more than the four documented fields"
+            );
+
+            // A write that failed is counted as a failed write, not as a write, and
+            // the store's own state explains itself: the directory is gone.
+            std::fs::remove_dir_all(&scratch.dir).expect("remove the state directory");
+            assert!(
+                store.save(b"an accepted login").is_err(),
+                "a removed state directory still accepts a write"
+            );
+            let failed = status_of(scratch.configured());
+            assert_eq!(failed["off"], json!("dir"));
+            assert_eq!(failed["writes"], json!(writes + 1));
+            assert_eq!(failed["write_failures"], json!(failures + 1));
+        }
+    }
