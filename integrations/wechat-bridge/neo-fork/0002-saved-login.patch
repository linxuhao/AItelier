+/// The account a stored login opened: the client this session goes on to use,
+/// and the name WeChat knew it by.
+struct AcceptedAccount {
+    client: NativeClient,
+    username: String,
+}
+
+/// The status token one resume attempt answers. One of the closed set the bridge
+/// branches on; `resumed` is the only answer that also names an account, and
+/// `mismatch` is the one that says the account it named was not the expected one.
+fn resume_status<T>(answered: &stored_login::Answer<T>) -> &'static str {
+    match answered {
+        stored_login::Answer::None => "none",
+        stored_login::Answer::Unreadable => "unreadable",
+        stored_login::Answer::Throttled => "throttled",
+        stored_login::Answer::Busy => "busy",
+        stored_login::Answer::Rejected => "rejected",
+        stored_login::Answer::Mismatch => "mismatch",
+        stored_login::Answer::Resumed { .. } => "resumed",
+    }
+}
+
+/// Whether the account WeChat just accepted is the one the caller expected.
+///
+/// A resume that named nobody expects whoever the stored login belongs to: that is
+/// what this call did before the expectation existed, and it stays the behaviour of
+/// every caller that passes nothing. A caller that did name an account is answered
+/// on that account's own name, never on the file's or the caller's word for it. An
+/// account WeChat accepted without naming is not the expected one either: a resume
+/// that cannot say which account it opened cannot be the account that was asked for.
+fn is_expected_account(expect: Option<&str>, resumed: &str) -> bool {
+    match expect {
+        None => true,
+        Some(expected) => !resumed.is_empty() && expected == resumed,
+    }
+}
+
+/// Does the account WeChat has just accepted belong to the one the caller expected?
+///
+/// `true` means it does not: the resume must not go on, so `stop` runs here, before this
+/// attempt can answer, and the answer is `mismatch`. `stop` is a parameter because the
+/// only account the product has is a live WeChat client, and this way a test with no
+/// client can witness the decision itself - the account is stopped, and only when the
+/// login belongs to somebody else.
+fn another_account(expect: Option<&str>, own_username: &str, stop: impl FnOnce()) -> bool {
+    if is_expected_account(expect, own_username) {
+        return false;
+    }
+    stop();
+    true
+}
+
+/// Try the stored login instead of the QR path, for the account `expect` names.
+///
+/// Every answer the caller can see is one of the seven tokens; the store's own
+/// faults are answered as tokens too, and the only error that leaves here is a
+/// failed renewal, the one request to WeChat.
+fn resume_login(session: &mut Session, expect: Option<&str>) -> Result<Value> {
+    // A session is already live: its credentials are the current ones, so this is
+    // the design's `busy`, not a fault.
+    if session.account.is_some() {
+        return Ok(json!({ "status": "busy" }));
+    }
+    let store = match stored_login::Store::from_env() {
+        Ok(store) => store,
+        // Saved logins are off. The answer is still one of the closed set, and it
+        // says why, so a start can tell a build without a store from a login that
+        // is simply not there.
+        Err(off) => return Ok(json!({ "status": "none", "off": off.as_str() })),
+    };
+    // A clock this build cannot read is a fault on this side, not WeChat's: answer
+    // the token that says nothing was contacted and nothing was spent.
+    let now = match now_seconds() {
+        Ok(now) => now,
+        Err(_) => return Ok(json!({ "status": "throttled" })),
+    };
+    let answer = stored_login::resume(
+        &store,
+        now.into(),
+        open_stored_login,
+        |account| renew_stored_login(&store, expect, account),
+    )?;
+    let status = resume_status(&answer);
+    let stored_login::Answer::Resumed { accepted, .. } = answer else {
+        return Ok(json!({ "status": status }));
+    };
+    session.account = Some(accepted.client);
+    Ok(json!({ "status": status, "username": accepted.username }))
+}
+
+/// Turn the bytes a stored login holds into an account this build can use, without
+/// contacting anybody. Bytes this build cannot use are `Unreadable`, which keeps
+/// the file: a document from another version is evidence, not garbage.
+fn open_stored_login(bytes: &[u8]) -> stored_login::Readable<AcceptedAccount> {
+    let Ok(state) = serde_json::from_slice::<AccountState>(bytes) else {
+        return stored_login::Readable::Unreadable;
+    };
+    // Constructing a client touches no network and no store, so a document that
+    // fails here is unreadable rather than a failed resume.
+    match NativeClient::from_account(state, options()) {
+        // The name WeChat knows the account by arrives with the renewal, so it is
+        // empty until `renew_stored_login` fills it in.
+        Ok(client) => stored_login::Readable::Usable(AcceptedAccount {
+            client,
+            username: String::new(),
+        }),
+        Err(_) => stored_login::Readable::Unreadable,
+    }
+}
+
+/// Present those credentials to WeChat, once, and say how that went. A refusal is
+/// `Rejected`, which drops the file, because the login in it is not good any more;
+/// anything else is a failed renewal and leaves here as an error. The rotated
+/// credentials are written by `renew_and_persist`, which is how this path saves
+/// them: because every renewal does, not on its own account.
+///
+/// A login that turns out to belong to another account than the one `expect` names is
+/// `Mismatched`: WeChat has just accepted these credentials, so the account is live
+/// and is stopped right here, and the store deletes the file this attempt read, still
+/// inside the writer lock the attempt holds.
+fn renew_stored_login(
+    store: &stored_login::Store,
+    expect: Option<&str>,
+    mut account: AcceptedAccount,
+) -> Result<stored_login::Opened<AcceptedAccount>> {
+    let refreshed = match stored_login::renew_and_persist(
+        store,
+        || account.client.renew_session_blocking(DEVICE_NAME),
+        || account.client.export_account_state(),
+    ) {
+        Ok(refreshed) => refreshed,
+        Err(error) if is_session_rejected(&error) => return Ok(stored_login::Opened::Rejected),
+        Err(error) => return Err(error),
+    };
+    account.username = refreshed.own_username.clone();
+    if another_account(expect, &account.username, || {
+        // The stored login belongs to another account, and WeChat has accepted it: a
+        // session that is not the caller's is live, so it ends before this attempt
+        // answers. A stop that fails leaves the same answer - the account must not be
+        // resumed either way, and an error here would keep the other account's file on
+        // disk, which is the round trip this answer exists to stop paying.
+        let _ = account.client.stop();
+    }) {
+        return Ok(stored_login::Opened::Mismatched);
+    }
+    Ok(stored_login::Opened::Accepted(account))
+}
