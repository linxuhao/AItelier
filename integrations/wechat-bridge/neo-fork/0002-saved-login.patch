+        #[test]
+        fn a_lock_naming_our_pid_with_another_start_time_is_stale_and_is_stolen() {
+            let _counting = counting();
+            let scratch = Scratch::new("pid-reuse");
+            let store = scratch.store();
+            let me = std::process::id();
+            let started = start_time(me).expect("this process has a start time in /proc");
+            // What a crash left behind in a container that restarted and handed the
+            // same pid to us: the pid is ours, the process is not.
+            std::fs::write(
+                store.lock_path(),
+                format!("{me} {}\n", started + 1),
+            )
+            .expect("a reused pid's lock");
+
+            let answer = resume(&store, seconds(), usable, accepted)
+                .expect("a stale lock is not an error");
+            assert_eq!(
+                answer,
+                Answer::None,
+                "a lock a process whose pid we reused left behind answered busy for good"
+            );
+            assert!(
+                !store.lock_path().exists(),
+                "the reused-pid lock was not removed"
+            );
+
+            // And what this process actually writes is its identity, both halves.
+            let held = Lock::take(&store)
+                .expect("the writer lock opens")
+                .expect("nobody else holds it");
+            let body = std::fs::read(store.lock_path()).expect("the lock file");
+            assert_eq!(
+                Holder::parse(&body),
+                Some(Holder {
+                    pid: me,
+                    started
+                }),
+                "the lock file does not name the process holding it"
+            );
+            assert_eq!(
+                resume(&store, seconds(), usable, accepted)
+                    .expect("a busy answer is not an error"),
+                Answer::Busy,
+                "the lock this process holds did not read as live"
+            );
+            drop(held);
+        }
