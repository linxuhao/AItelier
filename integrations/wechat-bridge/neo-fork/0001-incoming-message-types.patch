 }
 
+/// An incoming message of any type. `outgoing` is the only thing dropped here:
+/// whether an arriving type may enter a conversation is the consumer's decision.
+fn incoming_message(message: wire::AddMessage) -> Option<IncomingMessage> {
+    if message.message_type == 1 {
+        return incoming_text(message).map(IncomingMessage::Text);
+    }
+    if message.outgoing {
+        return None;
+    }
+    let id = message.server_message_id?;
+    let (talker, listener, room) = if message.from.ends_with("@chatroom") {
+        let room = message.from;
+        let talker = message.sender_id.unwrap_or_else(|| room.clone());
+        (talker, None, Some(room))
+    } else {
+        (message.from, Some(message.to), None)
+    };
+    Some(IncomingMessage::Typed(TypedMessage {
+        id,
+        talker,
+        listener,
+        room,
+        message_type: message.message_type,
+        content: STANDARD.encode(&message.content),
+        inline_data: (!message.inline_data.is_empty())
+            .then(|| STANDARD.encode(&message.inline_data)),
+        timestamp: message.created_at,
+    }))
+}
