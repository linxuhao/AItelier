+// ---------------------------------------------------------------------------
+// Stored login (steward design step 19.1, section 7.2.1)
+//
+// An accepted login is written to disk encrypted with AES-256-GCM under a
+// 32-byte key the operator supplies by path, so a fresh bridge process can
+// resume it instead of asking for another QR scan. Every answer here is typed:
+// a store that is switched off, unreadable or throttled never becomes a panic,
+// and a read that fails never deletes the file it could not read.
+// ---------------------------------------------------------------------------
+mod stored_login {
+    // The surface here is wider than this build's callers: `Miss::as_str` and
+    // `Allowance::as_str` are reached only from the tests at the bottom of this
+    // file, and `Answer::Resumed`'s `state` field is never read outside them.
+    // Everything else has a non-test caller in lib.rs.
+    #![allow(dead_code)]
+
+    use anyhow::{anyhow, Result};
+    use base64::{engine::general_purpose::STANDARD, Engine};
+    use serde_json::{json, Value};
+    use std::{
+        ffi::OsString,
+        fs::{File, OpenOptions},
+        io::{ErrorKind, Write},
+        os::unix::fs::{OpenOptionsExt, PermissionsExt},
+        path::{Path, PathBuf},
+        sync::atomic::{AtomicU64, Ordering},
+        time::{Duration, SystemTime, UNIX_EPOCH},
+    };
+
+    /// Environment variable naming the directory the store lives in.
+    pub const STATE_DIR_ENV: &str = "PUPPET_NEO_STATE_DIR";
+    /// Environment variable naming the file that holds the 32-byte key.
+    pub const STATE_KEY_ENV: &str = "PUPPET_NEO_STATE_KEY_FILE";
+
+    /// The one envelope schema this build writes, and the only one it opens.
+    const SCHEMA: &str = "puppet-neo/stored-login/1";
+    /// The AAD binds every ciphertext to this store: the same key used for
+    /// another purpose (a different AAD) does not decrypt here, so a ciphertext
+    /// moved in from elsewhere fails instead of opening. An edited schema line is
+    /// not what the AAD catches - the equality check in `open` rejects it before
+    /// a key is used at all.
+    const AAD: &[u8] = b"puppet-neo/stored-login/1";
+    const STATE_FILE: &str = "account.v1";
+    const RESUMES_FILE: &str = "resumes";
+    pub const KEY_LEN: usize = 32;
+    /// At most six resume attempts in an hour and twenty in a day. The counters
+    /// live in the store, not in memory, so a restart does not reset them.
+    pub const RESUMES_PER_HOUR: usize = 6;
+    pub const RESUMES_PER_DAY: usize = 20;
+    const HOUR: u64 = 3_600;
+    const DAY: u64 = 86_400;
+    /// The writer lock one resume at a time holds. It carries the holder's pid
+    /// and the start time of the process that pid names, so a lock a killed
+    /// process left behind can be told from a live holder even when a restart
+    /// handed its pid to somebody else.
+    const LOCK_FILE: &str = "resume.lock";
+    /// How long a lock file that names no holder may exist before it is judged
+    /// abandoned. A holder creates the file with `create_new` and only then writes
+    /// its identity, and those two steps are not atomic between processes, so the
+    /// gap in between must read as a live holder rather than as a crash's debris.
+    const LOCK_GRACE: Duration = Duration::from_secs(5);
+
+    /// This process's stored-login writes and failed writes. They are not
+    /// persisted: a fresh process starts at zero, so the row describes the
+    /// bridge that is running now, not what ever happened.
+    static WRITES: AtomicU64 = AtomicU64::new(0);
+    static WRITE_FAILURES: AtomicU64 = AtomicU64::new(0);
+
+    /// Why persistence is off — the closed set a status row may show.
+    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
+    pub enum Off {
+        NotConfigured,
+        Key,
+        Dir,
+    }
+
+    impl Off {
+        pub fn as_str(self) -> &'static str {
+            match self {
+                Off::NotConfigured => "not_configured",
+                Off::Key => "key",
+                Off::Dir => "dir",
+            }
+        }
+    }
+
+    /// Why a stored login was not resumed. `Absent` is the design's `none`.
+    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
+    pub enum Miss {
+        Absent,
+        Unreadable,
+    }
+
+    impl Miss {
+        pub fn as_str(self) -> &'static str {
+            match self {
+                Miss::Absent => "none",
+                Miss::Unreadable => "unreadable",
+            }
+        }
+    }
+
+    /// Whether one resume attempt may contact WeChat now.
+    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
+    pub enum Allowance {
+        Allowed,
+        Throttled,
+    }
+
+    impl Allowance {
+        pub fn as_str(self) -> &'static str {
+            match self {
+                Allowance::Allowed => "allowed",
+                Allowance::Throttled => "throttled",
+            }
+        }
+    }
+
+    #[derive(Debug, Clone)]
+    pub struct Store {
+        dir: PathBuf,
+        key_file: PathBuf,
+    }
+
+    impl Store {
+        /// Resolve the operator's two paths. Any of these answers off, and a store
+        /// that is off is never read or written: neither variable set, no key file
+        /// at that path, a key file that is not an owner-only regular file, or a
+        /// state directory that is missing or is not a directory.
+        ///
+        /// Nothing here reads the key's bytes or writes into the state directory:
+        /// an lstat and a directory check decide. A key of the wrong length and a
+        /// directory that refuses a write are answered where they are used, from
+        /// the real error, so merely configuring or reporting a store never opens
+        /// the operator's secret file and never creates a file to find out.
+        pub fn from_parts(
+            state_dir: Option<OsString>,
+            key_file: Option<OsString>,
+        ) -> std::result::Result<Store, Off> {
+            let (Some(dir), Some(key_file)) = (state_dir, key_file) else {
+                return Err(Off::NotConfigured);
+            };
+            let dir = PathBuf::from(dir);
+            if !dir.is_dir() {
+                return Err(Off::Dir);
+            }
+            let key_file = PathBuf::from(key_file);
+            check_key_file(&key_file)?;
+            Ok(Store { dir, key_file })
+        }
+
+        pub fn from_env() -> std::result::Result<Store, Off> {
+            Store::from_parts(
+                std::env::var_os(STATE_DIR_ENV),
+                std::env::var_os(STATE_KEY_ENV),
+            )
+        }
+
+        pub fn dir(&self) -> &Path {
+            &self.dir
+        }
+
+        pub fn state_path(&self) -> PathBuf {
+            self.dir.join(STATE_FILE)
+        }
+
+        pub fn resumes_path(&self) -> PathBuf {
+            self.dir.join(RESUMES_FILE)
+        }
+
+        pub fn lock_path(&self) -> PathBuf {
+            self.dir.join(LOCK_FILE)
+        }
+
+        /// Is there a stored login? lstat only — the answer a status row needs
+        /// and must not pay a decrypt for. A file that exists but will not open
+        /// still answers true here; `read` is what tells the two apart.
+        pub fn present(&self) -> bool {
+            self.state_path().symlink_metadata().is_ok()
+        }
+
+        /// The key's bytes, read when a write or a read actually needs them. A
+        /// key that is gone, is no longer owner-only or is the wrong length is an
+        /// error here, never a reason the store is off: a status row and a resume
+        /// that finds nothing stored leave this file alone entirely.
+        fn key(&self) -> Result<[u8; KEY_LEN]> {
+            read_key(&self.key_file)
+        }
+
+        /// Seal `plaintext` and put it in place atomically. The key is read once
+        /// per write, so a key the operator replaced takes effect on the next
+        /// write and a key that cannot be used fails this write and nothing else.
+        pub fn write(&self, plaintext: &[u8]) -> Result<()> {
+            let key = self.key()?;
+            let envelope = seal(&key, plaintext)?;
+            atomic_write(&self.state_path(), &envelope)
+        }
+
+        pub fn read(&self) -> std::result::Result<Vec<u8>, Miss> {
+            // The state file first: an attempt that finds nothing stored must not
+            // touch the operator's key file at all.
+            let envelope = match std::fs::read(self.state_path()) {
+                Ok(bytes) => bytes,
+                Err(err) if err.kind() == ErrorKind::NotFound => return Err(Miss::Absent),
+                Err(_) => return Err(Miss::Unreadable),
+            };
+            let key = self.key().map_err(|_| Miss::Unreadable)?;
+            open(&key, &envelope).map_err(|_| Miss::Unreadable)
+        }
+
+        /// Remove the stored login. Idempotent: a file that is already gone is
+        /// the state the caller asked for.
+        pub fn delete(&self) -> Result<()> {
+            match std::fs::remove_file(self.state_path()) {
+                Ok(()) => Ok(()),
+                Err(err) if err.kind() == ErrorKind::NotFound => Ok(()),
+                Err(err) => Err(err.into()),
+            }
+        }
+
+        /// Count one resume attempt and say whether it may go. A counter file
+        /// that cannot be read, cannot be parsed or cannot be written fails
+        /// closed: the attempt is refused rather than left uncounted.
+        pub fn allow_resume(&self, now: u64) -> Allowance {
+            let mut seen = match read_counters(&self.resumes_path()) {
+                Ok(seen) => seen,
+                Err(_) => return Allowance::Throttled,
+            };
+            seen.retain(|at| now.saturating_sub(*at) < DAY);
+            let hour = seen
+                .iter()
+                .filter(|at| now.saturating_sub(**at) < HOUR)
+                .count();
+            if hour >= RESUMES_PER_HOUR || seen.len() >= RESUMES_PER_DAY {
+                return Allowance::Throttled;
+            }
+            seen.push(now);
+            let mut body = String::new();
+            for at in &seen {
+                body.push_str(&format!("{at}\n"));
+            }
+            if atomic_write(&self.resumes_path(), body.as_bytes()).is_err() {
+                return Allowance::Throttled;
+            }
+            Allowance::Allowed
+        }
+    }
+
+    impl Store {
+        /// Seal `plaintext`, count the attempt, and put it in place atomically.
+        /// A write that fails is counted too: a store that cannot be written is
+        /// the thing the counters exist to show.
+        pub fn save(&self, plaintext: &[u8]) -> Result<()> {
+            let written = self.write(plaintext);
+            match &written {
+                Ok(()) => WRITES.fetch_add(1, Ordering::Relaxed),
+                Err(_) => WRITE_FAILURES.fetch_add(1, Ordering::Relaxed),
+            };
+            written
+        }
+    }
+
+    /// What a stored login's bytes turn into before any request is made. The
+    /// split exists so that the throttle slot is spent only once there is an
+    /// account a renewal can actually be attempted with.
+    pub enum Readable<T> {
+        /// A login this build can put on the wire. Nothing has been sent yet.
+        Usable(T),
+        /// The bytes are not a login this build can use; the file is kept.
+        Unreadable,
+    }
+
+    /// What contacting WeChat answered.
+    pub enum Opened<T> {
+        /// WeChat accepted the credentials the stored bytes carry.
+        Accepted(T),
+        /// WeChat refused these credentials; the file is deleted. A delete that
+        /// fails is a failed write and the answer is still `rejected`.
+        Rejected,
+        /// WeChat accepted them and they belong to another account than the caller
+        /// expected. This is this side's judgement, not WeChat's answer: the caller of
+        /// `open` has already stopped that account, and the file - the only one this
+        /// attempt read, through the store it holds - is deleted here, inside the
+        /// writer lock, exactly as a rejected login's is.
+        Mismatched,
+    }
+
+    /// One resume attempt's answer: the closed set a caller branches on.
+    #[derive(Debug, PartialEq)]
+    pub enum Answer<T> {
+        /// There is no stored login to resume: none was stored, or the store is off.
+        None,
+        /// A stored login is there and did not open: it will not decrypt, or the
+        /// document is not a login this build can use. The file is kept.
+        Unreadable,
+        /// Nothing was contacted. Either the counters refused this attempt - the
+        /// bytes opened into a usable account, but the renewal never ran - or the
+        /// store could not be locked well enough to record an attempt at all.
+        Throttled,
+        /// Another resume holds the writer lock. Neither the envelope nor the
+        /// counters were read, so a race costs nothing and records nothing.
+        Busy,
+        /// WeChat refused the stored login; the file is deleted.
+        Rejected,
+        /// WeChat accepted the stored login and it belongs to another account than the
+        /// caller expected: that account was stopped and the file is deleted, so the
+        /// next start does not connect as it again.
+        Mismatch,
+        /// WeChat accepted the stored login. `state` is the plaintext this attempt
+        /// read, i.e. the credentials from before its own renewal rotated them;
+        /// the rotated ones are what that renewal wrote back to the store.
+        Resumed { state: Vec<u8>, accepted: T },
+    }
+
+    /// The resume writer lock, held for one attempt and dropped on every exit
+    /// path, a panic included.
+    struct Lock {
+        path: PathBuf,
+        holder: Holder,
+    }
+
+    impl Lock {
+        /// Take the lock, or answer `None` when somebody else holds it. The file
+        /// is created with `create_new`, so the create itself has exactly one
+        /// winner; taking a file `abandoned` judged stale is serialised by `reap`,
+        /// and the comment there says why that is enough.
+        ///
+        /// The create is retried once after removing a stale file, and a second
+        /// refusal means somebody else won that race - the same `busy`.
+        fn take(store: &Store) -> Result<Option<Lock>> {
+            let path = store.lock_path();
+            for attempt in 0..2 {
+                match OpenOptions::new()
+                    .write(true)
+                    .create_new(true)
+                    .mode(0o600)
+                    .open(&path)
+                {
+                    Ok(mut file) => {
+                        let holder = Holder::current();
+                        let written = (|| -> Result<()> {
+                            file.write_all(holder.line().as_bytes())?;
+                            file.sync_all()?;
+                            Ok(())
+                        })();
+                        if let Err(err) = written {
+                            let _ = std::fs::remove_file(&path);
+                            return Err(err);
+                        }
+                        return Ok(Some(Lock { path, holder }));
+                    }
+                    Err(err) if err.kind() == ErrorKind::AlreadyExists => {
+                        if attempt == 1 {
+                            return Ok(None);
+                        }
+                        let Ok(judged) = std::fs::read(&path) else {
+                            return Ok(None);
+                        };
+                        if !abandoned(&path, &judged, SystemTime::now()) {
+                            return Ok(None);
+                        }
+                        if !steal_if_stale(store, &path, &judged, SystemTime::now()) {
+                            return Ok(None);
+                        }
+                    }
+                    Err(err) => return Err(err.into()),
+                }
+            }
+            Ok(None)
+        }
+    }
+
+    /// Serialise the steal on the reap file and re-judge staleness from a fresh
+    /// read before unlinking. Returns true only when the lock was actually removed.
+    ///
+    /// What this does not close: a live session's own renewal, on the recovery path
+    /// in `read_session`, writes the store without taking this lock, so a resume that
+    /// races it can still read the credentials from before that renewal. The reap
+    /// file serialises stealers against each other, not against that writer.
+    fn steal_if_stale(store: &Store, path: &Path, _judged: &[u8], now: SystemTime) -> bool {
+        let Ok(Some(_reap)) = reap(store) else {
+            return false;
+        };
+        let Ok(second) = std::fs::read(path) else {
+            return false;
+        };
+        if !abandoned(path, &second, now) {
+            return false;
+        }
+        std::fs::remove_file(path).is_ok()
+    }
+    /// deliberately never removed: unlinking it would let a later attempt lock a
+    /// different inode at the same name, which is the race this closes.
+    const REAP_FILE: &str = "resume.lock.reap";
+
+    // `flock(2)`, declared here instead of taken from a crate this patch cannot
+    // add as a dependency.
+    #[cfg(unix)]
+    unsafe extern "C" {
+        fn flock(fd: std::os::raw::c_int, operation: std::os::raw::c_int) -> std::os::raw::c_int;
+    }
+
+    /// `LOCK_EX` and `LOCK_NB`: exclusive, and do not wait. The bits are the same
+    /// on every unix this addon builds for.
+    #[cfg(unix)]
+    const LOCK_EX: std::os::raw::c_int = 2;
+    #[cfg(unix)]
+    const LOCK_NB: std::os::raw::c_int = 4;
+
+    /// Take the right to steal a stale lock, or `None` when another attempt holds
+    /// it. The kernel drops this lock when the process exits, so a stealer that
+    /// dies half way cannot wedge every later attempt the way a lock file could.
+    #[cfg(unix)]
+    fn reap(store: &Store) -> Result<Option<File>> {
+        use std::os::unix::io::AsRawFd;
+        let file = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .mode(0o600)
+            .open(store.dir().join(REAP_FILE))?;
+        // SAFETY: the descriptor is open for this whole call and `flock` neither
+        // reads the number after it returns nor keeps it.
+        let taken = unsafe { flock(file.as_raw_fd(), LOCK_EX | LOCK_NB) };
+        Ok((taken == 0).then_some(file))
+    }
+
+    /// Without `flock(2)` there is no way to serialise the steal, so there is no
+    /// steal: the attempt answers `busy` and spends nothing rather than unlinking
+    /// a lock another process may have created in the meantime.
+    #[cfg(not(unix))]
+    fn reap(_store: &Store) -> Result<Option<File>> {
+        Ok(None)
+    }
+
+    impl Drop for Lock {
+        fn drop(&mut self) {
+            if let Ok(bytes) = std::fs::read(&self.path) {
+                if bytes == self.holder.line().as_bytes() {
+                    let _ = std::fs::remove_file(&self.path);
+                }
+            }
+        }
+    }
+
+    /// Who holds a lock. A pid is not an identity: a container restart hands the
+    /// same pid to a new process, and a lock a crash left behind would then read as
+    /// a live holder forever, i.e. `busy` for good.
+    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
+    struct Holder {
+        pid: u32,
+        /// Field 22 of `/proc/<pid>/stat`: the process's start time in clock ticks
+        /// since boot, which separates this process from a later one that reused
+        /// its pid.
+        started: u64,
+    }
+
+    impl Holder {
+        /// This process, now.
+        fn current() -> Holder {
+            let pid = std::process::id();
+            Holder {
+                pid,
+                started: start_time(pid).unwrap_or(0),
+            }
+        }
+
+        /// The lock file's contents: the identity, one line.
+        fn line(self) -> String {
+            format!("{} {}\n", self.pid, self.started)
+        }
+
+        /// Parse a lock file. `None` means it names no holder, which is what a
+        /// holder that created the file but has not written it yet leaves.
+        fn parse(body: &[u8]) -> Option<Holder> {
+            let text = std::str::from_utf8(body).ok()?;
+            let mut fields = text.split_whitespace();
+            let pid = fields.next()?.parse().ok()?;
+            let started = fields.next()?.parse().ok()?;
+            if fields.next().is_some() {
+                return None;
+            }
+            Some(Holder { pid, started })
+        }
+
+        /// Is the process this identity names still that process?
+        fn live(self) -> Liveness {
+            match start_time(self.pid) {
+                Some(started) if started == self.started => Liveness::Alive,
+                Some(_) => Liveness::Gone,
+                // No `/proc/<pid>`: either the process is gone, or `/proc` is not
+                // mounted here and the answer is unknown. Unknown counts as alive,
+                // because taking a lock from a live resume is worse than `busy`.
+                None if proc_mounted() => Liveness::Gone,
+                None => Liveness::Unknown,
+            }
+        }
+    }
+
+    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
+    enum Liveness {
+        Alive,
+        Gone,
+        Unknown,
+    }
+
+    /// Field 22 of `/proc/<pid>/stat`, in clock ticks since boot. Field 2 is the
+    /// command name in parentheses and may contain spaces, so the fields are
+    /// counted from the last `)`.
+    fn start_time(pid: u32) -> Option<u64> {
+        let stat = std::fs::read(format!("/proc/{pid}/stat")).ok()?;
+        let stat = String::from_utf8_lossy(&stat);
+        let after = &stat[stat.rfind(')')? + 1..];
+        // `after` starts at field 3 (state), so field 22 is index 19.
+        after.split_whitespace().nth(22 - 3)?.parse().ok()
+    }
+
+    fn proc_mounted() -> bool {
+        std::fs::metadata("/proc")
+            .map(|meta| meta.is_dir())
+            .unwrap_or(false)
+    }
+
+    /// Is the lock file whose bytes are `bytes` abandoned? One that names a holder
+    /// is abandoned exactly when that holder is gone. One that names nobody is
+    /// abandoned only once it is older than `LOCK_GRACE`, because a holder creates
+    /// the file and then writes its identity, and the gap between them is not a
+    /// crash.
+    fn abandoned(path: &Path, bytes: &[u8], now: SystemTime) -> bool {
+        let Some(holder) = Holder::parse(bytes) else {
+            return match std::fs::metadata(path).and_then(|meta| meta.modified()) {
+                Ok(written) => now
+                    .duration_since(written)
+                    .map(|age| age >= LOCK_GRACE)
+                    .unwrap_or(false),
+                // No timestamp to judge by: treat it as a live holder.
+                Err(_) => false,
+            };
+        };
+        holder.live() == Liveness::Gone
+    }
+
+    /// Try the stored login. In this order: take the writer lock, read the store,
+    /// turn its bytes into a usable account, count the attempt, and only then
+    /// contact WeChat - `open` is the caller's one request, and the slot is spent
+    /// immediately before it. A file that is not there, a file that will not read
+    /// and a document this build cannot use answer `none` and `unreadable` and
+    /// spend no throttle slot, so an empty or broken store cannot exhaust the
+    /// counters and turn the next real resume into a refusal. `busy` is the one
+    /// answer that neither reads the envelope nor counts anything, so a second
+    /// start racing the first costs nothing. A lock or directory fault answers
+    /// `throttled`: a store that cannot record an attempt is not one to spend.
+    pub fn resume<T>(
+        store: &Store,
+        now: u64,
+        prepare: impl FnOnce(&[u8]) -> Readable<T>,
+        open: impl FnOnce(T) -> Result<Opened<T>>,
+    ) -> Result<Answer<T>> {
+        let held = match Lock::take(store) {
+            Ok(held) => held,
+            // The lock cannot be created or read, so there is no way to record or
+            // bound this attempt: fail closed without contacting anybody.
+            Err(_) => return Ok(Answer::Throttled),
+        };
+        let Some(_lock) = held else {
+            return Ok(Answer::Busy);
+        };
+        let state = match store.read() {
+            Ok(state) => state,
+            Err(Miss::Absent) => return Ok(Answer::None),
+            Err(Miss::Unreadable) => return Ok(Answer::Unreadable),
+        };
+        let usable = match prepare(&state) {
+            Readable::Usable(usable) => usable,
+            Readable::Unreadable => return Ok(Answer::Unreadable),
+        };
+        // The slot is spent only here: the bytes opened into an account, so the
+        // one request to WeChat is actually about to be made.
+        if store.allow_resume(now) == Allowance::Throttled {
+            return Ok(Answer::Throttled);
+        }
+        match open(usable)? {
+            Opened::Accepted(accepted) => Ok(Answer::Resumed { state, accepted }),
+            Opened::Mismatched => {
+                // Another account's login, which the opener has already stopped. The
+                // file to delete is the one this attempt read through this store, and
+                // it is deleted while the writer lock above is still held, so a second
+                // start cannot read it between this answer and the unlink. Nothing else
+                // in the state directory is touched: not the counters, not the key,
+                // not the lock. A delete that fails is a failed write and still
+                // `mismatch` - the login is not resumed either way.
+                if store.delete().is_err() {
+                    WRITE_FAILURES.fetch_add(1, Ordering::Relaxed);
+                }
+                Ok(Answer::Mismatch)
+            }
+            Opened::Rejected => {
+                // WeChat said this login is no longer good, so the file is not
+                // evidence of anything: keeping it would make every start pay the
+                // same rejected round trip. A delete that fails is a failed write
+                // and still `rejected` - the login is not resumed either way, and
+                // the next start pays the same round trip rather than an error.
+                if store.delete().is_err() {
+                    WRITE_FAILURES.fetch_add(1, Ordering::Relaxed);
+                }
+                Ok(Answer::Rejected)
+            }
+        }
+    }
+
+    /// The row `savedLoginStatus` answers: whether a stored login is there (an
+    /// lstat, never a decrypt), why the store is off when it is, and this
+    /// process's write counters.
+    pub fn status() -> Value {
+        status_of(Store::from_env())
+    }
+
+    pub fn status_of(store: std::result::Result<Store, Off>) -> Value {
+        let (present, off) = match &store {
+            Ok(store) => (store.present(), None),
+            Err(off) => (false, Some(off.as_str())),
+        };
+        let mut row = json!({
+            "present": present,
+            "writes": WRITES.load(Ordering::Relaxed),
+            "write_failures": WRITE_FAILURES.load(Ordering::Relaxed),
+        });
+        // An `off` reason is present only when the store is: a configured store
+        // has nothing to explain.
+        if let (Some(off), Some(fields)) = (off, row.as_object_mut()) {
+            fields.insert("off".to_string(), json!(off));
+        }
+        row
+    }
+
+    /// Renew the account's credentials and write the rotated ones down. A renewal
+    /// mints new keys, so the login on disk stops being the current one the moment
+    /// it succeeds: a later resume would present keys WeChat already replaced, be
+    /// refused, and lose the file it read as a rejected login. That is why the
+    /// write is part of renewing here, and why every renewal goes through this
+    /// function - the resume's own and the recovery path's alike - instead of each
+    /// call site remembering to save afterwards.
+    pub fn renew_and_persist<S: serde::Serialize>(
+        store: &Store,
+        renew: impl FnOnce() -> Result<()>,
+        rotated: impl FnOnce() -> Result<S>,
+    ) -> Result<S> {
+        renew()?;
+        let minted = rotated()?;
+        record_into(store, &minted);
+        Ok(minted)
+    }
+
+    /// Write an accepted account through this store. The login it follows already
+    /// succeeded, so a store that is off or a write that fails is a counter, never
+    /// a failed login.
+    pub fn record_into(store: &Store, account: &impl serde::Serialize) {
+        match serde_json::to_vec(account) {
+            Ok(bytes) => {
+                let _ = store.save(&bytes);
+            }
+            Err(_) => {
+                WRITE_FAILURES.fetch_add(1, Ordering::Relaxed);
+            }
+        }
+    }
+
+    /// `record_into` against the store this process is configured with, if any:
+    /// for the paths that hold an account but no store.
+    pub fn record(account: &impl serde::Serialize) {
+        if let Ok(store) = Store::from_env() {
+            record_into(&store, account);
+        }
+    }
+
+    /// Drop the stored login: WeChat says these credentials are no longer good,
+    /// or the account logged out. A store that is off has nothing to drop.
+    pub fn forget() {
+        if let Ok(store) = Store::from_env() {
+            let _ = store.delete();
+        }
+    }
+
+    /// The key file as the operator left it: it exists, it is a regular file, and
+    /// it has no permission bit for anybody else. Deciding this from
+    /// `symlink_metadata` is the point - this is all a store's configuration looks
+    /// at, so configuring or reporting a store never opens the operator's secret.
+    fn check_key_file(path: &Path) -> std::result::Result<(), Off> {
+        let meta = std::fs::symlink_metadata(path).map_err(|_| Off::Key)?;
+        if !meta.file_type().is_file() {
+            return Err(Off::Key);
+        }
+        if meta.permissions().mode() & 0o077 != 0 {
+            return Err(Off::Key);
+        }
+        Ok(())
+    }
+
+    /// The key's bytes, read once per use. The same checks as `check_key_file` run
+    /// again, because the file can be replaced between configuration and use, and
+    /// a wrong length is answered here: a status row may report a login while a
+    /// write against a 31-byte key fails and says why.
+    fn read_key(path: &Path) -> Result<[u8; KEY_LEN]> {
+        check_key_file(path).map_err(|_| anyhow!("the key file is not an owner-only regular file"))?;
+        let bytes = std::fs::read(path).map_err(|err| anyhow!("the key file cannot be read: {err}"))?;
+        if bytes.len() != KEY_LEN {
+            return Err(anyhow!(
+                "the key file is {} bytes, not {KEY_LEN}",
+                bytes.len()
+            ));
+        }
+        let mut key = [0u8; KEY_LEN];
+        key.copy_from_slice(&bytes);
+        Ok(key)
+    }
+
+    fn read_counters(path: &Path) -> Result<Vec<u64>> {
+        let body = match std::fs::read_to_string(path) {
+            Ok(body) => body,
+            Err(err) if err.kind() == ErrorKind::NotFound => return Ok(Vec::new()),
+            Err(err) => return Err(err.into()),
+        };
+        let mut seen = Vec::new();
+        for line in body.lines() {
+            let line = line.trim();
+            if line.is_empty() {
+                continue;
+            }
+            seen.push(
+                line.parse::<u64>()
+                    .map_err(|_| anyhow!("a resume counter is not a unix second"))?,
+            );
+        }
+        Ok(seen)
+    }
+
+    fn atomic_write(path: &Path, bytes: &[u8]) -> Result<()> {
+        let dir = path
+            .parent()
+            .ok_or_else(|| anyhow!("the stored login has no directory"))?;
+        let name = path
+            .file_name()
+            .map(|name| name.to_string_lossy().into_owned())
+            .unwrap_or_else(|| "login".to_string());
+        let tmp = dir.join(format!(".{name}.tmp.{}.{}", std::process::id(), nanos()));
+        let write = (|| -> Result<()> {
+            let mut file = OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .mode(0o600)
+                .open(&tmp)?;
+            file.write_all(bytes)?;
+            file.sync_all()?;
+            Ok(())
+        })();
+        if let Err(err) = write {
+            let _ = std::fs::remove_file(&tmp);
+            return Err(err);
+        }
+        if let Err(err) = std::fs::rename(&tmp, path) {
+            let _ = std::fs::remove_file(&tmp);
+            return Err(err.into());
+        }
+        // The rename is durable only once the directory itself is flushed.
+        if let Ok(dir) = File::open(dir) {
+            let _ = dir.sync_all();
+        }
+        Ok(())
+    }
+
+    fn seal(key: &[u8; KEY_LEN], plaintext: &[u8]) -> Result<Vec<u8>> {
+        seal_aad(key, AAD, plaintext)
+    }
+
+    /// Seal under a given AAD. Only the tests pass anything but `AAD`, to build
+    /// the envelope a ciphertext from another purpose would be.
+    fn seal_aad(key: &[u8; KEY_LEN], aad: &[u8], plaintext: &[u8]) -> Result<Vec<u8>> {
+        use openssl::symm::{Cipher, Crypter, Mode};
+        let mut nonce = [0u8; 12];
+        openssl::rand::rand_bytes(&mut nonce)?;
+        let mut crypter = Crypter::new(Cipher::aes_256_gcm(), Mode::Encrypt, key, Some(&nonce))?;
+        crypter.aad_update(aad)?;
+        let mut body = vec![0u8; plaintext.len() + 16];
+        let mut written = crypter.update(plaintext, &mut body)?;
+        written += crypter.finalize(&mut body[written..])?;
+        body.truncate(written);
+        let mut tag = [0u8; 16];
+        crypter.get_tag(&mut tag)?;
+        let envelope = json!({
+            "schema": SCHEMA,
+            "nonce": STANDARD.encode(nonce),
+            "tag": STANDARD.encode(tag),
+            "ciphertext": STANDARD.encode(&body),
+        });
+        Ok(serde_json::to_vec(&envelope)?)
+    }
+
+    fn open(key: &[u8; KEY_LEN], envelope: &[u8]) -> Result<Vec<u8>> {
+        use openssl::symm::{Cipher, Crypter, Mode};
+        let doc: Value = serde_json::from_slice(envelope)?;
+        if doc.get("schema").and_then(Value::as_str) != Some(SCHEMA) {
+            return Err(anyhow!("the stored login carries another schema"));
+        }
+        let field = |name: &str| -> Result<Vec<u8>> {
+            let text = doc
+                .get(name)
+                .and_then(Value::as_str)
+                .ok_or_else(|| anyhow!("the stored login has no {name}"))?;
+            STANDARD
+                .decode(text)
+                .map_err(|_| anyhow!("the stored login's {name} is not base64"))
+        };
+        let nonce = field("nonce")?;
+        let tag = field("tag")?;
+        let body = field("ciphertext")?;
+        if nonce.len() != 12 || tag.len() != 16 {
+            return Err(anyhow!("the stored login's envelope is the wrong size"));
+        }
+        let mut crypter = Crypter::new(Cipher::aes_256_gcm(), Mode::Decrypt, key, Some(&nonce))?;
+        crypter.aad_update(AAD)?;
+        let mut plain = vec![0u8; body.len() + 16];
+        let mut written = crypter.update(&body, &mut plain)?;
+        crypter.set_tag(&tag)?;
+        written += crypter.finalize(&mut plain[written..])?;
+        plain.truncate(written);
+        Ok(plain)
+    }
+
+    fn nanos() -> u128 {
+        SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map(|elapsed| elapsed.as_nanos())
+            .unwrap_or(0)
+    }
