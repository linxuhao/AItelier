# Rendered by install_dsh_host.py; install the generated unit, not this template.
[Unit]
Description=AItelier resident DSH drivers
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO@
ExecStart=@PYTHON@ -m core.dsh_host
Environment=@HOME_ENV@
Environment=@PATH_ENV@
Environment=@DSH_BIN_ENV@
Environment=@STATE_ENV@
Environment=@DB_ENV@
Environment=@SECRETS_ENV@
Environment="AITELIER_DRIVER_IDENTITY=on"
Environment=@API_ENV@
Environment="GIT_CONFIG_COUNT=1"
Environment="GIT_CONFIG_KEY_0=credential.helper"
Environment=@GIT_HELPER_ENV@
Environment=@GITHUB_TOKEN_ENV@
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=45
UMask=0077

[Install]
WantedBy=default.target
