+test('an inbound fetch says which stage it stopped at: no session, or no login', async () => {
+  // Nothing has started, so there is no session to fetch through at all.
+  const { puppet } = scriptedPuppet([], () => ({}))
+  await assert.rejects(puppet.messageFile('4294967296'), /has no session to fetch a file from/)
+  await assert.rejects(puppet.messageImage('4294967299'), /has no session to fetch an image from/)
+  await assert.rejects(puppet.messageVoice('4294967300'), /has no session to fetch a voice note from/)
+
+  // A session that failed before login is not one a fetch may use either.
+  const failed = scriptedPuppet([], () => ({ laterHeartbeat: new Error('Neo could not check session heartbeat') }))
+  const loggedOut = waitFor(done => failed.puppet.once('logout', done), 'logout')
+  await failed.puppet.start()
+  try {
+    await loggedOut
+    await assert.rejects(failed.puppet.messageFile('4294967296'), /not logged in/)
+    await assert.rejects(failed.puppet.messageImage('4294967299'), /not logged in/)
+    await assert.rejects(failed.puppet.messageVoice('4294967300'), /not logged in/)
+  } finally {
+    await failed.puppet.stop()
+  }
