{
  "schema": "aitelier.director-messaging.conformance.v2",
  "project_ids": [
    "alpha",
    "beta",
    "gamma"
  ],
  "scenarios": [
    {
      "id": "target-list-lifecycle-and-replay",
      "actor": "transport-a",
      "steps": [
        {
          "action": "send_director_message",
          "arguments": {
            "sender_project_id": "alpha",
            "director_identity": "director-a",
            "request_key": "send-1",
            "subject": "Café",
            "body": "first body",
            "target_project_id": "beta"
          },
          "schema": "sendSuccess",
          "expect": {
            "schema": "aitelier.director-messaging.v2",
            "result": {
              "message": {
                "sender_project_id": "alpha",
                "director_identity": "director-a",
                "actor": "transport-a",
                "subject": "Café",
                "body": "first body",
                "reply_to_delivery_id": null
              },
              "deliveries": [
                {
                  "target_project_id": "beta",
                  "delivery_seq": 1,
                  "status": "unread",
                  "version": 1
                }
              ],
              "replayed": false
            }
          },
          "capture": {
            "d1": "/result/deliveries/0/delivery_id",
            "m1": "/result/message/message_id",
            "t1": "/result/message/thread_id"
          }
        },
        {
          "action": "list_director_messages",
          "arguments": {
            "project_id": "beta"
          },
          "schema": "listSuccess",
          "expect": {
            "schema": "aitelier.director-messaging.v2",
            "result": {
              "project_id": "beta",
              "items": [
                {
                  "message": {
                    "message_id": "@capture:m1",
                    "thread_id": "@capture:t1",
                    "subject": "Café",
                    "body": "first body"
                  },
                  "delivery": {
                    "delivery_id": "@capture:d1",
                    "delivery_seq": 1,
                    "status": "unread",
                    "version": 1
                  }
                }
              ],
              "next_after": 1
            }
          }
        },
        {
          "action": "acknowledge_director_message",
          "arguments": {
            "project_id": "beta",
            "delivery_id": "@capture:d1",
            "expected_version": 1,
            "request_key": "ack-1"
          },
          "schema": "transitionSuccess",
          "expect": {
            "schema": "aitelier.director-messaging.v2",
            "result": {
              "delivery": {
                "delivery_id": "@capture:d1",
                "status": "acknowledged",
                "version": 2
              },
              "replayed": false
            }
          }
        },
        {
          "action": "acknowledge_director_message",
          "arguments": {
            "project_id": "beta",
            "delivery_id": "@capture:d1",
            "expected_version": 1,
            "request_key": "ack-1"
          },
          "schema": "transitionSuccess",
          "expect": {
            "schema": "aitelier.director-messaging.v2",
            "result": {
              "delivery": {
                "delivery_id": "@capture:d1",
                "status": "acknowledged",
                "version": 2
              },
              "replayed": true
            }
          }
        },
        {
          "action": "resolve_director_message",
          "arguments": {
            "project_id": "beta",
            "delivery_id": "@capture:d1",
            "expected_version": 2,
            "request_key": "resolve-1"
          },
          "schema": "transitionSuccess",
          "expect": {
            "schema": "aitelier.director-messaging.v2",
            "result": {
              "delivery": {
                "delivery_id": "@capture:d1",
                "status": "resolved",
                "version": 3
              },
              "replayed": false
            }
          }
        },
        {
          "action": "resolve_director_message",
          "arguments": {
            "project_id": "beta",
            "delivery_id": "@capture:d1",
            "expected_version": 1,
            "request_key": "resolve-already"
          },
          "schema": "transitionSuccess",
          "expect": {
            "schema": "aitelier.director-messaging.v2",
            "result": {
              "delivery": {
                "delivery_id": "@capture:d1",
                "status": "resolved",
                "version": 3
              },
              "replayed": false
            }
          }
        },
        {
          "action": "acknowledge_director_message",
          "arguments": {
            "project_id": "beta",
            "delivery_id": "@capture:d1",
            "expected_version": 3,
            "request_key": "ack-regress"
          },
          "schema": "error",
          "expect": {
            "schema": "aitelier.director-messaging.v2",
            "code": "invalid_transition",
            "detail": {
              "message": "invalid_transition"
            }
          }
        },
        {
          "action": "acknowledge_director_message",
          "arguments": {
            "project_id": "gamma",
            "delivery_id": "@capture:d1",
            "expected_version": 1,
            "request_key": "ack-wrong-box"
          },
          "schema": "error",
          "expect": {
            "schema": "aitelier.director-messaging.v2",
            "code": "unknown_delivery",
            "detail": {
              "message": "unknown_delivery"
            }
          }
        },
        {
          "action": "send_director_message",
          "arguments": {
            "sender_project_id": "alpha",
            "director_identity": "director-a",
            "request_key": "send-1",
            "subject": "Hello",
            "body": "changed",
            "target_project_id": "beta"
          },
          "schema": "error",
          "expect": {
            "schema": "aitelier.director-messaging.v2",
            "code": "idempotency_conflict",
            "detail": {
              "message": "idempotency_conflict"
            }
          }
        },
        {
          "action": "list_director_messages",
          "arguments": {
            "project_id": "beta",
            "after": 1,
            "limit": 1
          },
          "schema": "listSuccess",
          "expect": {
            "schema": "aitelier.director-messaging.v2",
            "result": {
              "project_id": "beta",
              "items": [],
              "next_after": 1
            }
          }
        }
      ]
    },
