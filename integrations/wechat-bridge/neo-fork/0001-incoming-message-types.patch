+test('an arriving file, image and voice note each come back as the FileBox to re-send', async () => {
+  const trace: unknown[] = []
+  const fileBytes = Buffer.from('the bytes WeChat held for the owner').toString('base64')
+  const pngBytes = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0x00, 0x01]).toString('base64')
+  const wavBytes = Buffer.from('RIFF....WAVEfmt ....data....').toString('base64')
+  const file = (id: string, content: string): IncomingMessage =>
+    ({ id, talker: sender, listener: username, messageType: 49, content: Buffer.from(content).toString('base64'), timestamp: 1700000010 })
+  const fileMessage = file('4294967296', '<msg><appmsg appid="" sdkver="0"><title>报告 &amp; notes</title><type>6</type>'
+    + '<appattach><totallen>12345</totallen><fileext>pdf</fileext>'
+    + '<cdnattachurl>cdn-file-blob</cdnattachurl><aeskey>00112233445566778899AABBCCDDEEFF</aeskey>'
+    + '</appattach></appmsg></msg>')
+  // A file beyond WeChat's single 25 MiB transfer goes by blocks instead.
+  const bigFile = file('4294967297', '<msg><appmsg><title>holiday.mov</title><type>6</type>'
+    + '<appattach><totallen>26214401</totallen><fileext>mov</fileext>'
+    + '<cdnattachurl>cdn-large-blob</cdnattachurl><aeskey>00112233445566778899aabbccddeeff</aeskey>'
+    + '</appattach></appmsg></msg>')
+  // An app message that is not a file at all: a quoted reply is type 57.
+  const quoted = file('4294967298', '<msg><appmsg><title>quoted</title><type>57</type></appmsg></msg>')
+  const pictureMessage: IncomingMessage = {
+    id: '4294967299',
+    talker: sender,
+    listener: username,
+    messageType: 3,
+    content: Buffer.from('<msg><img aeskey="00112233445566778899aabbccddeeff" cdnbigimgurl="cdn-picture"'
+      + ' cdnmidimgurl="cdn-middle" length="54321" cdnthumburl="cdn-thumb" /></msg>').toString('base64'),
+    timestamp: 1700000011,
+  }
+  const voiceMessage: IncomingMessage = {
+    id: '4294967300',
+    talker: sender,
+    listener: username,
+    messageType: 34,
+    content: Buffer.from('<msg><voicemsg voiceformat="4" length="1200" voicelength="2000" endflag="1" /></msg>').toString('base64'),
+    timestamp: 1700000012,
+  }
+  const { puppet, events } = scriptedPuppet(trace, () => ({
+    messages: [fileMessage, bigFile, quoted, pictureMessage, voiceMessage],
+    downloads: { 'cdn-file-blob': fileBytes, 'cdn-picture': pngBytes },
+    decodedVoice: { wavBase64: wavBytes, durationMs: 2000 },
+  }))
+  const arrivals = waitFor<void>(done => {
+    let seen = 0
+    puppet.on('message', () => { if (++seen === 5) done() })
+  }, 'five messages')
+  await puppet.start()
+  try {
+    await arrivals
+
+    // The descriptor each payload yields, which is what the addon's download takes.
+    const downloaded = await puppet.messageFile(fileMessage.id)
+    assert.equal(downloaded.name, '报告 & notes.pdf')
+    assert.equal(downloaded.mediaType, 'application/pdf')
+    assert.equal((await downloaded.toBuffer()).toString(), Buffer.from(fileBytes, 'base64').toString())
+
+    const picture = await puppet.messageImage(pictureMessage.id)
+    assert.equal(picture.name, `${pictureMessage.id}.png`, 'the picture names itself by what it is')
+    assert.equal(picture.mediaType, 'image/png')
+    assert.deepEqual(await picture.toBuffer(), Buffer.from(pngBytes, 'base64'))
+
+    const voice = await puppet.messageVoice(voiceMessage.id)
+    assert.equal(voice.name, '2000ms.wav', 'the length the note plays is what names it')
+    assert.match(voice.mediaType, /wav/)
+    assert.deepEqual(await voice.toBuffer(), Buffer.from(wavBytes, 'base64'))
+
+    const mediaSteps = ['download-media', 'download-voice', 'decode-voice']
+    assert.deepEqual(trace.filter(step => Array.isArray(step) && mediaSteps.includes(String(step[0]))), [
+      ['download-media', 'cdn-file-blob', '00112233445566778899aabbccddeeff', 'file', 12345],
+      ['download-media', 'cdn-picture', '00112233445566778899aabbccddeeff', 'original', 54321],
+      ['download-voice', voiceMessage.id, 1200],
+      ['decode-voice', 'c2lsaw=='],
+    ])
+    // The 25 MiB file is not fetched by the next test's message; it is only parsed when
+    // asked for, so asking for it is what proves the profile split.
+    await puppet.messageFile(bigFile.id)
+    assert.deepEqual(trace.filter(step => Array.isArray(step) && step[0] === 'download-media').at(-1),
+      ['download-media', 'cdn-large-blob', '00112233445566778899aabbccddeeff', 'large_file', 26214401])
+
+    // A message of another kind is refused by the type WeChat itself sent.
+    await assert.rejects(puppet.messageFile(pictureMessage.id), /WeChat message of type 3/)
+    await assert.rejects(puppet.messageImage(voiceMessage.id), /WeChat message of type 34/)
+    await assert.rejects(puppet.messageVoice(fileMessage.id), /WeChat message of type 49/)
+    // An app message that carries something else says which app type it is.
+    await assert.rejects(puppet.messageFile(quoted.id), /app message is of type 57, not a file/)
+    // And a payload the cache no longer holds is refused, never answered with no bytes.
+    await assert.rejects(puppet.messageFile('4294967999'), /no longer cached/)
+    assert.deepEqual(events.errors, [])
+  } finally {
+    await puppet.stop()
+  }
+})
