+/// otherwise become a note WeChat plays at the wrong speed, and silently.
+fn wav_pcm(wav: &[u8]) -> Result<&[u8]> {
+    ensure!(
+        wav.len() >= 44 && &wav[0..4] == b"RIFF" && &wav[8..12] == b"WAVE",
+        "The audio is not a RIFF/WAVE file"
+    );
+    let (mut format, mut data) = (None, None);
+    let mut cursor = 12;
+    while cursor + 8 <= wav.len() {
+        let id = &wav[cursor..cursor + 4];
+        let size = usize::try_from(u32::from_le_bytes(
+            wav[cursor + 4..cursor + 8].try_into()?,
+        ))?;
+        let body = cursor + 8;
+        let end = body
+            .checked_add(size)
+            .context("The audio's WAV chunk is oversized")?;
+        ensure!(end <= wav.len(), "The audio's WAV chunk runs past the file");
+        match id {
+            b"fmt " => format = Some(&wav[body..end]),
+            b"data" => data = Some(&wav[body..end]),
+            _ => {}
+        }
+        // RIFF chunks are word-aligned: an odd-sized one is followed by a pad byte.
+        cursor = end + (size & 1);
+    }
+    let format = format.context("The audio's WAV file has no format chunk")?;
+    ensure!(
+        format.len() >= 16
+            && u16::from_le_bytes(format[0..2].try_into()?) == 1
+            && u16::from_le_bytes(format[2..4].try_into()?) == 1
+            && u32::from_le_bytes(format[4..8].try_into()?) == silk::SAMPLE_RATE
+            && u16::from_le_bytes(format[14..16].try_into()?) == 16,
+        "The audio is not 16 kHz mono 16-bit PCM"
+    );
