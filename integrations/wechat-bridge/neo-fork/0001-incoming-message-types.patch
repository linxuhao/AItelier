+/// An error and its causes in one line, stopping at the endpoint the transport dialled.
+///
+/// The chain is the story of a failed transfer: the step this addon was in ("The media
+/// key is not 32 hex characters"), then the crate's own reason ("Invalid CDN key",
+/// "CDN HTTP status 500", "Advertised media size mismatch"). A transport error's text
+/// carries the CDN address it dialled - `error sending request for url (http://...)` -
+/// so each cause stops where its URL starts: the sub-step is kept and the address is
+/// not, and no credential or message content is in any of these messages.
+fn cause_chain(error: &anyhow::Error) -> String {
+    error
+        .chain()
+        .map(|cause| {
+            let text = cause.to_string();
+            match text.find(" for url (") {
+                Some(url) => text[..url].trim_end().to_string(),
+                None => text,
+            }
+        })
+        .filter(|cause| !cause.is_empty())
+        .collect::<Vec<_>>()
+        .join(": ")
+}
