# AItelier environment variables — example
#
# Copy to `.env` and fill in your keys, then load them into your shell:
#   cp .env.example .env
#   source .env
#
# `.env` is gitignored; this `.env.example` is safe to commit (no secrets).
# Provider base URLs are configured in llm_providers.json — only the keys live here.

# AItelier is PROVIDER-AGNOSTIC. llm_providers.json maps a provider name to a
# base_url and the NAME of the key it reads; an agent_config's `model` picks
# one. Adding your own provider is one entry there plus a secret file of that
# name — nothing in the code names a vendor. The shipped entries (deepseek,
# ark, localqwen) are examples; below are the keys THEY happen to read.
# See docs/external-dependencies.md.
#
# DOCKER: do NOT put this key here. It is delivered as a Docker secret (a file)
# so test/build subprocesses that inherit the environment never receive it:
#   mkdir -p ~/.aitelier-secrets && chmod 700 ~/.aitelier-secrets
#   printf '%s' "sk-..." > ~/.aitelier-secrets/DEEPSEEK_API_KEY && chmod 600 "$_"

# Volcengine Ark (token plan) — ONE key serves deepseek, glm, doubao, kimi and
# minimax through an OpenAI-compatible endpoint; llm_providers.json's `ark` entry
# is where a model gets registered. Same file-secret rule as the key above: in
# Docker it is a MOUNTED SECRET, not an env var, so build/test subprocesses that
# inherit os.environ never receive it.
#   printf '%s' "$ARK_KEY" > ~/.aitelier-secrets/ARK_API_KEY && chmod 600 "$_"
# The default agent roster runs on ark; a role's model is a plain field in
# agent_configs/, so switching provider is an edit there, not a code change.
# ai_router reads /run/secrets/DEEPSEEK_API_KEY. For LOCAL (non-docker) runs,
# either set AITELIER_SECRETS_DIR=~/.aitelier-secrets or export the key below.
# export DEEPSEEK_API_KEY=""

# GitHub auth for private-repo clone + push + PR (repository panel / clone mode).
# Same secret-file model — a FINE-GRAINED PAT, NOT in this file. Scope it to the
# repos you push to (Contents: R/W, Pull requests: R/W):
#   printf '%s' "github_pat_..." > ~/.aitelier-secrets/GITHUB_TOKEN && chmod 600 "$_"
# An empty/absent file = no credentials (public clone still works). The
# container's git-credential-helper.sh feeds it to github.com only.

# Optional: other providers are registered in llm_providers.json. Add a key here
# only if you point an agent_config at that provider.
# export MINIMAX_API_KEY=""

# Optional: model for skillflow "host"-delegated agents. The skill_converter
# pipeline (and any generated pipeline) declares its agents as model:"host" with
# the prompt embedded; AItelier maps that single token to one real model.
# Defaults to ark/deepseek-v4-flash. Override only to use a different model.
# export AITELIER_HOST_AGENT_MODEL="ark/deepseek-v4-flash"

# Optional: pin EVERY agent to one model, overriding the explicit per-role
# models in agent_configs/ (the production DPE mix puts architect / pm /
# final_verifier on a stronger model than the rest). For benchmark and ablation
# runs only: holding the model fixed is what makes a result attributable to the
# harness, and running with/without it measures the pro-vs-flash delta.
# Unset = no effect; the production mix stays the default.
# export AITELIER_FORCE_ALL_AGENT_MODELS="ark/deepseek-v4-flash"

# Optional: web search backend.
# AItelier's web_search tool queries a SearXNG instance (JSON API). It is
# OPTIONAL — leave SEARXNG_URL unset and the pipeline runs fine without web
# search (agents fall back to model knowledge; web_fetch still works on any URL).
# To enable, point at your own SearXNG (recommended) or a public instance that
# exposes format=json:
# export SEARXNG_URL="http://localhost:8888"
# export SEARXNG_TIMEOUT="10"

# ── Cloudflare Access write-gate (Docker deployment) ──
# When the app is fronted by Cloudflare Access, reads are protected at the edge
# (any logged-in user) and writes are restricted to an allowlist. Set the team
# domain + the Access application's AUD tag to enable JWT verification; leave
# them blank to disable the gate (local dev — all requests allowed).
# export AITELIER_CF_TEAM_DOMAIN="<team>.cloudflareaccess.com"
# export AITELIER_CF_AUD="<application-audience-aud-tag>"
# Comma-separated emails allowed to perform writes (create/modify projects).
# export AITELIER_WRITERS="you@example.com"
# Shared secret the host CLI sends to bypass the write-gate (it has no JWT).
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# export AITELIER_ADMIN_TOKEN="<random-secret>"

# ══ Things that are specific to ONE machine ═════════════════════════════════
# Everything below points at a host that is not part of this repo. All of it is
# optional; the defaults are the AUTHOR'S own boxes, so on any other machine you
# either point these somewhere real or leave the feature off. They are listed
# here because none of them announce themselves — a `docker compose up` succeeds
# and the gap only shows up when a run reaches the step that needs it.

# ── Publishing through an existing cloudflared connector ──
# Naming the network opts in to docker-compose.edge.yml FOR THE CLI, which adds
# the overlay with -f when this is set (cli/server.py:_compose_files). A plain
# `docker compose` does NOT read it — compose only knows the files it is given.
# Leave both unset and AItelier stays on 127.0.0.1:4444.
#   docker network ls   → confirm the name on YOUR host
# export AITELIER_EDGE_NETWORK="vip-gateway_default"
#
# Set COMPOSE_FILE too, or a hand-run `docker compose up -d` silently recreates
# the container WITHOUT the gateway network and the public path dies while
# localhost still answers 200 — 2026-08-25, a rebuild to ship a UI change took
# the tunnel down and nothing said so. COMPOSE_FILE makes plain compose agree
# with the CLI; the CLI passes -f explicitly, so it wins either way.
# export COMPOSE_FILE=docker-compose.yml:docker-compose.edge.yml

# ── Media generation (sprites, audio) ──
# The `gen_image_asset` / `gen_audio_asset` tools are thin clients over a shared
# MCP media server that keeps the models and the GPU on one box. Without it they
# raise MCPError naming the URL they could not reach; nothing else is affected.
# NOTE the MEDIA_ in the name: `AITELIER_MCP_URL` is the DSH plugin's variable
# for the opposite direction (where Harness finds AItelier).
# export AITELIER_MEDIA_MCP_URL="http://mcp_server:9003/mcp"
# export AITELIER_MEDIA_MCP_TIMEOUT="600"

# ── Godot readability gate (game projects only) ──
# `godot_vision` shows the play-test's rendered frames to a vision model and
# fails a game that is unreadable despite green assertions. Set in
# docker-compose.yml, where the default is a Tailscale address on the author's
# network. Point it at your own OpenAI-compatible vision endpoint, or accept
# that the gate reports itself BLIND rather than silently passing.
#   GODOT_VISION_URL / GODOT_VISION_MODEL / GODOT_VISION_CONTEXT_TOKENS
#
# The Godot COMPILE + play-test sidecar needs none of this — it ships in this
# repo as the `godot-builder` compose service.

# ── Self-hosted vLLM ──
# llm_providers.json's `localqwen` entry points at a Tailscale address on the
# author's network. Leave it alone unless you run your own vLLM: nothing selects
# that provider unless an agent_config names one of its models.
