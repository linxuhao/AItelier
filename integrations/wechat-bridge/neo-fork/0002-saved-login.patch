+        /// Cargo runs this module's tests on parallel threads of one process and
+        /// the write counters are process-wide, so a test that asserts on them
+        /// takes this first: the delta it reads is then its own write.
+        static COUNTERS: std::sync::Mutex<()> = std::sync::Mutex::new(());
+
+        fn counting() -> std::sync::MutexGuard<'static, ()> {
+            COUNTERS
+                .lock()
+                .unwrap_or_else(|poisoned| poisoned.into_inner())
+        }
+
+        fn seconds() -> u64 {
+            SystemTime::now()
+                .duration_since(UNIX_EPOCH)
+                .map(|elapsed| elapsed.as_secs())
+                .unwrap_or(0)
+        }
+
+        /// The two halves of a resume that goes all the way: the bytes are a login
+        /// this build can use, and WeChat accepts it. A test that scripts one half
+        /// names its own.
+        fn opens(state: &[u8]) -> Readable<Vec<u8>> {
+            Readable::Usable(state.to_vec())
+        }
+
+        fn accepts(state: Vec<u8>) -> Result<Opened<Vec<u8>>> {
+            Ok(Opened::Accepted(state))
+        }
+
+        fn usable(_: &[u8]) -> Readable<()> {
+            Readable::Usable(())
+        }
+
+        fn accepted(_: ()) -> Result<Opened<()>> {
+            Ok(Opened::Accepted(()))
+        }
