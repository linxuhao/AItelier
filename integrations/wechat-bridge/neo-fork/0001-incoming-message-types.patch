-fn text_messages(commands: Vec<wire::SyncCommand>, username: &str) -> Vec<TextMessage> {
+fn incoming_messages(commands: Vec<wire::SyncCommand>, username: &str) -> Vec<IncomingMessage> {
     commands
         .into_iter()
