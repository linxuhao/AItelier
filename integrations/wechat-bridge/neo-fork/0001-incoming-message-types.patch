+test('the built addon downloads media, and carries the SILK codec in both directions', async () => {
+  // The addon the image ships, asked for the four entry points the puppet calls. The
+  // downloads stop at the stage they name because this process has no WeChat account; the
+  // codec reaches no network at all, so it is driven for real here.
+  const puppet = new class extends PuppetNeo {
+    openSession() { return this.createSession() }
+  }()
+  const session = puppet.openSession()
+  try {
+    await assert.rejects(session.downloadMedia('cdn-file-blob', '00'.repeat(16), 'file'), /download a WeChat file/)
+    await assert.rejects(session.downloadMedia('cdn-picture', '00'.repeat(16), 'original'), /download a WeChat image/)
+    await assert.rejects(session.downloadVoice('4294967296', 1200), /download a WeChat voice note/)
+    await assert.rejects(session.decodeVoice('audio'), /decode a WeChat voice note/)
+    await assert.rejects(session.encodeWav('audio'), /encode a WeChat voice note/)
+
+    // 200 ms of 16 kHz mono PCM in, one SILK note out, and the WAV it decodes to back.
+    const pcm = Buffer.alloc(3200 * 2)
+    for (let sample = 0; sample < 3200; sample++) {
+      pcm.writeInt16LE(Math.round(Math.sin(sample * 0.1) * 8000), sample * 2)
+    }
+    const note = await session.encodeVoice(pcm.toString('base64'))
+    assert.equal(note.durationMs, 200)
+    const decoded = await session.decodeVoice(note.voice)
+    const wav = Buffer.from(decoded.wavBase64, 'base64')
+    // The header the bytes actually carry: what a player and the channel both rely on.
+    assert.equal(wav.subarray(0, 4).toString('latin1'), 'RIFF')
+    assert.equal(wav.subarray(8, 12).toString('latin1'), 'WAVE')
+    assert.equal(wav.readUInt16LE(22), 1, 'mono')
+    assert.equal(wav.readUInt32LE(24), 16000, '16 kHz')
+    assert.equal(wav.readUInt16LE(34), 16, '16 bits per sample')
+    assert.equal(wav.readUInt32LE(40), 3200 * 2, 'every sample the note held')
+    assert.equal(decoded.durationMs, 200)
+
+    // And the WAV goes back to a note, so an arriving note can leave again as a bubble.
+    // SILK is lossy, so the samples differ; the note it makes is the same shape again.
+    const again = await session.encodeWav(decoded.wavBase64)
+    assert.equal(again.durationMs, 200)
+    const twice = Buffer.from((await session.decodeVoice(again.silkBase64)).wavBase64, 'base64')
+    assert.equal(twice.readUInt16LE(22), 1, 'mono')
+    assert.equal(twice.readUInt32LE(24), 16000, '16 kHz')
+    assert.equal(twice.readUInt16LE(34), 16, '16 bits per sample')
+    assert.equal(twice.readUInt32LE(40), 3200 * 2, 'the same 200 ms of samples')
+  } finally {
+    await session.close()
+  }
+})
