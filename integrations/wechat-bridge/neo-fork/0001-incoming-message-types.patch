+/// A message whose type is not text, carried out of the addon as it arrived.
+///
+/// The addon is a protocol client, not a policy: it reports WeChat's own type and
+/// the raw payload, and the consumer decides which arriving types may enter a
+/// conversation.
+#[derive(Debug, PartialEq, Serialize)]
+#[serde(rename_all = "camelCase")]
+struct TypedMessage {
+    id: String,
+    /// Who wrote the message. In a group the wire names the group: the member who
+    /// posted a non-text message is not in the payload.
+    talker: String,
+    /// The account that received a direct message.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    listener: Option<String>,
+    /// The group the message was posted in.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    room: Option<String>,
+    /// WeChat's message type: image 3, voice 34, video 43, sticker 47, app (a
+    /// quoted reply) 49 or 57, system notice 10000.
+    message_type: i32,
+    /// The raw `content` bytes, base64, exactly as the wire carried them.
+    content: String,
+    /// The raw `inline_data` bytes, base64, when the message carries any.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    inline_data: Option<String>,
+    timestamp: u32,
+}
+
+/// Any incoming message. Text keeps the shape and the handling it had; every other
