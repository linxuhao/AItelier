        {
          "action": "list_director_messages",
          "arguments": {
            "project_id": "alpha"
          },
          "schema": "listSuccess",
          "expect": {
            "schema": "aitelier.director-messaging.v2",
            "result": {
              "project_id": "alpha",
              "items": [
                {
                  "message": {
                    "sender_project_id": "beta",
                    "thread_id": "@capture:bt",
                    "reply_to_delivery_id": "@capture:bd_beta"
                  },
                  "delivery": {
                    "delivery_id": "@capture:reply_delivery",
                    "target_project_id": "alpha",
                    "delivery_seq": 1
                  }
                }
              ],
              "next_after": 1
            }
          },
          "actor": "transport-c"
        },
        {
          "action": "send_director_message",
          "arguments": {
            "sender_project_id": "gamma",
            "director_identity": "director-c",
            "request_key": "bad-reply",
            "subject": "No",
            "body": "",
