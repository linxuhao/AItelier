+    /// Try the stored login. In this order: take the writer lock, count the
+    /// attempt, read the store, and only then contact WeChat - `open` is the
+    /// caller's one request. `busy` is the one answer that neither reads the
+    /// envelope nor spends a throttle slot, so a second start racing the first
+    /// costs nothing.
+    pub fn resume<T>(
+        store: &Store,
+        now: u64,
+        open: impl FnOnce(&[u8]) -> Result<Opened<T>>,
+    ) -> Result<Answer<T>> {
+        let Some(_lock) = Lock::take(store)? else {
+            return Ok(Answer::Busy);
+        };
+        if store.allow_resume(now) == Allowance::Throttled {
+            return Ok(Answer::Throttled);
+        }
+        let state = match store.read() {
+            Ok(state) => state,
+            Err(Miss::Absent) => return Ok(Answer::None),
+            Err(Miss::Unreadable) => return Ok(Answer::Unreadable),
+        };
+        match open(&state)? {
+            Opened::Accepted(accepted) => Ok(Answer::Resumed { state, accepted }),
+            Opened::Unreadable => Ok(Answer::Unreadable),
+            Opened::Rejected => {
+                // WeChat said this login is no longer good, so the file is not
+                // evidence of anything: keeping it would make every start pay the
+                // same rejected round trip.
+                store.delete()?;
+                Ok(Answer::None)
+            }
+        }
+    }
