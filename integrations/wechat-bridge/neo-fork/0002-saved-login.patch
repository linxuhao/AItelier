+        #[test]
+        fn a_held_lock_answers_busy_without_spending_a_throttle_slot() {
+            let _counting = counting();
+            let scratch = Scratch::new("busy");
+            let store = scratch.store();
+            // One attempt already spent, so there is a counter file to compare.
+            assert_eq!(store.allow_resume(seconds()), Allowance::Allowed);
+            let spent = std::fs::read(store.resumes_path()).expect("the counter file");
+            let held = Lock::take(&store)
+                .expect("the writer lock opens")
+                .expect("nobody else holds it");
+
+            let answer = resume(&store, seconds(), |_| Ok(Opened::Accepted(())))
+                .expect("a busy answer is not an error");
+            assert_eq!(answer, Answer::Busy);
+            assert_eq!(
+                std::fs::read(store.resumes_path()).expect("the counter file"),
+                spent,
+                "a busy attempt spent a throttle slot"
+            );
+
+            // The next attempt after the lock is released is allowed to look, and
+            // finds nothing stored - which is a `none`, not a refusal.
+            drop(held);
+            let answer = resume(&store, seconds(), |_| Ok(Opened::Accepted(())))
+                .expect("a resumed answer is not an error");
+            assert_eq!(
+                answer,
+                Answer::None,
+                "the attempt after the lock was released was refused"
+            );
+            assert_eq!(
+                store.allow_resume(seconds()),
+                Allowance::Allowed,
+                "the next attempt after the busy one is not allowed"
+            );
+        }
