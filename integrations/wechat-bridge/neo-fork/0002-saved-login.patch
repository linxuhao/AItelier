+        assert_eq!(
+            resume_status(&stored_login::Answer::<()>::Unreadable),
+            "unreadable"
+        );
+        assert_eq!(
+            resume_status(&stored_login::Answer::<()>::Throttled),
+            "throttled"
+        );
+        assert_eq!(resume_status(&stored_login::Answer::<()>::Busy), "busy");
+        assert_eq!(
+            resume_status(&stored_login::Answer::<()>::Resumed {
+                state: Vec::new(),
+                accepted: (),
+            }),
+            "resumed"
+        );
+    }
+}
