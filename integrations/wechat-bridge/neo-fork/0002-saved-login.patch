+#[cfg(test)]
+mod resume_answer_tests {
+    use super::{another_account, is_expected_account, resume_status, stored_login};
+
+    /// The bridge branches on these tokens, so each answer names exactly one of
+    /// them and nothing else: `none`, `unreadable`, `throttled`, `busy`,
+    /// `rejected`, `mismatch`, `resumed`.
+    #[test]
+    fn every_resume_answer_is_one_of_the_closed_set() {
+        assert_eq!(resume_status(&stored_login::Answer::<()>::None), "none");
+        assert_eq!(
+            resume_status(&stored_login::Answer::<()>::Unreadable),
+            "unreadable"
+        );
+        assert_eq!(
+            resume_status(&stored_login::Answer::<()>::Throttled),
+            "throttled"
+        );
+        assert_eq!(resume_status(&stored_login::Answer::<()>::Busy), "busy");
+        assert_eq!(
+            resume_status(&stored_login::Answer::<()>::Rejected),
+            "rejected"
+        );
+        assert_eq!(
+            resume_status(&stored_login::Answer::<()>::Mismatch),
+            "mismatch"
+        );
+        assert_eq!(
+            resume_status(&stored_login::Answer::<()>::Resumed {
+                state: Vec::new(),
+                accepted: (),
+            }),
+            "resumed"
+        );
+    }
+
+    /// A caller that names no account expects whoever the file belongs to: the same
+    /// stored login that a named expectation can answer `mismatch` for still answers
+    /// `resumed`, and the account WeChat named is the one this attempt goes on to use.
+    #[test]
+    fn a_resume_with_no_expected_account_still_answers_resumed() {
+        // The account the stored login belongs to, and one a caller might name instead.
+        let stored = "wxid_the_login_belongs_to";
+        assert!(
+            is_expected_account(None, stored),
+            "a resume that expected nobody refused the account the file names"
+        );
+        assert!(is_expected_account(Some(stored), stored));
+        assert!(!is_expected_account(Some("wxid_expected"), stored));
+        assert!(
+            !is_expected_account(Some("wxid_expected"), ""),
+            "an account WeChat accepted without naming was taken for the expected one"
+        );
+        // `mismatch` is the seventh answer, and the six before it keep their tokens.
+        assert_eq!(
+            resume_status(&stored_login::Answer::<()>::Mismatch),
+            "mismatch"
+        );
+        assert_eq!(
+            resume_status(&stored_login::Answer::<()>::Resumed {
+                state: Vec::new(),
+                accepted: (),
+            }),
+            "resumed"
+        );
+    }
+
+    /// The decision `renew_stored_login` makes, driven with the real predicate and no
+    /// client at all: a login that belongs to another account is refused, and the
+    /// account WeChat had accepted is stopped before this attempt can answer; a caller
+    /// that expects nobody is not refused and stops nobody; and the account the file
+    /// names, expected by its own name, is resumed.
+    #[test]
+    fn a_login_for_another_account_is_refused_and_its_account_stopped_before_the_answer() {
+        let stopped = std::cell::Cell::new(false);
+        assert!(
+            another_account(Some("wxid_expected"), "wxid_other", || stopped.set(true)),
+            "a login that belongs to another account was not refused"
+        );
+        assert!(
+            stopped.get(),
+            "another account was refused without stopping the session WeChat had opened"
+        );
+
+        let stopped = std::cell::Cell::new(false);
+        assert!(
+            !another_account(None, "wxid_other", || stopped.set(true)),
+            "a resume that expected nobody refused the account the file names"
+        );
+        assert!(
+            !stopped.get(),
+            "a resume that expected nobody stopped the account it had just opened"
+        );
+
+        let stopped = std::cell::Cell::new(false);
+        assert!(
+            !another_account(Some("wxid_other"), "wxid_other", || stopped.set(true)),
+            "the account the caller expected by name was refused"
+        );
+        assert!(
+            !stopped.get(),
+            "the account the caller expected by name was stopped"
+        );
+    }
+}
