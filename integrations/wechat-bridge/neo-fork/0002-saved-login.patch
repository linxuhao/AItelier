+            let store = scratch.store();
+            store
+                .save(b"the credentials before the renewal")
+                .expect("store the login");
+            // What an account state looks like to the store: a document, which is
+            // what `record_into` serializes.
+            let rotated = json!({"schema": 1, "own_username": "fixture-self", "rotated": true});
+            let rotated_bytes = serde_json::to_vec(&rotated).expect("a document");
+
+            // What the recovery path does when WeChat rejects a read: renew, and
+            // write the credentials the renewal minted. Both halves are one call,
+            // so a renewal cannot happen without the write.
+            renew_and_persist(&store, || Ok(()), || Ok(rotated.clone()))
+                .expect("the renewal is saved");
+
+            assert_eq!(
+                store.read().expect("read the login back"),
+                rotated_bytes,
+                "the credentials the recovery renewal minted are not what is on disk"
+            );
+
+            // A resume straight after presents those bytes, not the stale ones.
+            let answer = resume(&store, seconds(), opens, accepts)
+                .expect("a resumed answer is not an error");
+            assert_eq!(
+                answer,
+                Answer::Resumed {
+                    state: rotated_bytes.clone(),
+                    accepted: rotated_bytes,
+                },
+                "a resume after the renewal presented the pre-renewal credentials"
+            );
+
+            // A renewal that failed writes nothing: a refusal cannot leave
+            // credentials on disk that WeChat never minted.
+            let before = store.read().expect("read the login");
+            assert!(
+                renew_and_persist(&store, || Err(anyhow!("refused")), || {
+                    Ok(json!({"never": true}))
+                })
+                .is_err(),
+                "a failed renewal answered success"
