# Dockerfile.godot — the aitelier-godot builder sidecar.
#
# The Godot analogue of Dockerfile.unity, but trivial by comparison: Godot's
# headless binary is a free ~120MB download with NO license activation, NO
# account, NO editor image. Base = python-slim (for the harness) + the Godot 4
# binary + the X/GL libs the linux build links against, plus Xvfb and Mesa's
# software rasteriser: the playtest gate captures real rendered frames, so it
# DOES open a display (--headless forces the dummy renderer, which draws no
# pixels at all). Serves docker/godot/godot_harness.py over HTTP on :8080.
# It also carries xdotool, so the sidecar can run a WINDOWED input gate that
# injects real X11 events — the layer Input.parse_input_event() skips, and the
# layer a player's mouse actually uses.

FROM python:3.12-slim

ARG GODOT_VERSION=4.4-stable
ARG GODOT_ZIP=Godot_v4.4-stable_linux.x86_64.zip

RUN apt-get update && apt-get install -y --no-install-recommends \
        wget unzip ca-certificates \
        libx11-6 libxcursor1 libxinerama1 libxrandr2 libxi6 libxext6 \
        libgl1 libglu1-mesa fontconfig libfontconfig1 \
        xvfb xauth libgl1-mesa-dri \
        xdotool \
    && rm -rf /var/lib/apt/lists/*

# xdotool is the DRIVER for the windowed input gate, and it is a build-time
# dependency for a reason. The play-test harness delivers its clicks with
# Godot's Input.parse_input_event(), which never reaches the GUI phase where a
# mouse_filter=STOP Control decides whether an event survives. On 2026-08-27
# that blind spot let jinyong-assets ship a full-screen STOP Control parked over
# the board: left-click movement was dead for every player, web and desktop,
# while the 57-scenario suite reported all green.
#
# The only way to see it from here is to drive a REAL window — Xvfb (already
# above, for frame capture) plus real X11 events. Installing xdotool into a
# RUNNING container works and then silently disappears on the next image
# rebuild, the same writable-layer trap the skillflow wheel override has, so
# the gate's driver belongs in the image.

# Fetch the headless-capable Godot 4 binary.
RUN wget -q "https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}/${GODOT_ZIP}" -O /tmp/godot.zip \
    && unzip -q /tmp/godot.zip -d /opt/godot \
    && mv /opt/godot/Godot_* /usr/local/bin/godot \
    && chmod +x /usr/local/bin/godot \
    && rm /tmp/godot.zip

# Godot writes editor/import metadata under $HOME/.config|.cache — give it a
# writable home so it works when run as an arbitrary host uid (compose `user:`).
ENV GODOT_BIN=/usr/local/bin/godot \
    HOME=/tmp/godot-home \
    PORT=8080
RUN mkdir -p /tmp/godot-home && chmod 0777 /tmp/godot-home

COPY docker/godot/godot_harness.py /srv/godot_harness.py

EXPOSE 8080
CMD ["python3", "/srv/godot_harness.py", "--serve"]
