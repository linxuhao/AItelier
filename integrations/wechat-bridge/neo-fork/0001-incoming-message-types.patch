 const CACHE_LIMIT = 2048
 
+/**
+ * The file a send carries, as Wechaty's FileBox interface describes it: a name and the
+ * bytes. Taken from the Puppet method's own signature, so this file needs no second
+ * dependency to say what it accepts.
+ */
+export type FileBoxInterface = Parameters<Puppet['messageSendFile']>[1]
+
+/**
+ * A message as the addon carried it: Wechaty's payload, plus WeChat's own type and
+ * the raw bytes behind it, so a consumer can see what arrived and not only its text.
+ */
+type CachedMessage = payloads.Message & Pick<IncomingMessage, 'messageType' | 'content' | 'inlineData'>
+
+/**
+ * Wechaty's type for a message Neo carried. Text is text; a WeChat type this puppet
+ * does not model is Unknown, never Text: a system notice that reads as text would
+ * turn WeChat's own announcement into a member speaking.
+ */
+function messageType({ messageType }: IncomingMessage): types.Message {
+  switch (messageType) {
+    case undefined:
+    case 1: return types.Message.Text
+    case 3: return types.Message.Image
+    case 34: return types.Message.Audio
+    case 43: return types.Message.Video
+    case 47: return types.Message.Emoticon
+    default: return types.Message.Unknown
+  }
